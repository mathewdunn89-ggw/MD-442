diff --git a/firmware/src/app/md442_presets.h b/firmware/src/app/md442_presets.h
index 9bbe9f6..6ac144b 100644
--- a/firmware/src/app/md442_presets.h
+++ b/firmware/src/app/md442_presets.h
@@ -54,3 +54,51 @@ static void md442_load_preset(pattern_t *p, const md442_preset_t *m)
     }
     p->swing = (uint8_t)(m->swing * 132 / 100 > 100 ? 100 : m->swing * 132 / 100);   /* MD|442 shuffle 50 + swing * .33 % */
 }
+
+/* MD|187 (hip-hop) and MD|888 (hard techno): their own factory patterns 1-8 (md_variant_presets.h) */
+#if defined(MD_VARIANT) && MD_VARIANT != 442
+#include "md_variant_presets.h"
+#if MD_VARIANT == 187
+#define MDV_PRESETS MDV_PRESETS_187
+#else
+#define MDV_PRESETS MDV_PRESETS_888
+#endif
+#define MDV_NPRESETS ((int)(sizeof MDV_PRESETS / sizeof MDV_PRESETS[0]))
+
+static void mdv_load_preset(pattern_t *p, const mdv_preset_t *m)
+{
+    int r, i;
+    for (r = 0; r < 11; r++)
+        for (i = 0; i < 16; i++) {
+            if ((m->d909[r] >> i) & 1u)
+                sm_set(p->drum[0].hit[r], i);
+            if ((m->d808[r] >> i) & 1u)
+                sm_set(p->drum[1].hit[r], i);
+        }
+    for (i = 0; i < 16; i++) {
+        if ((m->acc909 >> i) & 1u)
+            sm_set(p->drum[0].accent, i);
+        if ((m->acc808 >> i) & 1u)
+            sm_set(p->drum[1].accent, i);
+    }
+    p->drum[0].len = p->drum[1].len = 16;
+    p->brk.steps = m->brk_steps;
+    p->brk.slot_a = p->brk.slot_b = m->brk_slot;
+    p->brk.set[BRK_COMPLEX] = m->brk_complex;
+#if MD_VARIANT == 888
+    if (m->brk_slot == 2)
+        p->brk.set[BRK_ALEN] = 3;                        /* TRANCE is two bars: a slice a beat */
+#endif
+    for (i = 0; i < 16; i++)
+        p->brk.slice[i] = m->brk_slice[i];
+    if (m->root) {
+        bpart_t *b = &p->bass[0];
+        b->len = 16;
+        for (i = 0; i < 16; i++) {
+            b->step[i].note = (uint8_t)(m->root + m->notes[i]);
+            b->step[i].flags = m->flags[i] ? (uint8_t)(G_NOTE | (m->flags[i] & (BS_ACCENT | BS_SLIDE))) : G_REST;
+        }
+    }
+    p->swing = m->swing;
+}
+#endif
diff --git a/firmware/src/app/md_perform.c b/firmware/src/app/md_perform.c
new file mode 100644
index 0000000..a280016
--- /dev/null
+++ b/firmware/src/app/md_perform.c
@@ -0,0 +1,333 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* MD|442 PERFORM: the SMK-37's controls laid out for playing a live set from the keyboard alone
+ * (MD442, MD187 and MD888 share it). Included by main_fm1.c after the UI (ui.c) in this unity build.
+ *
+ *   OCTAVE- / OCTAVE+        the previous / next instrument: the 909's tracks, the 808's, 303A, 303B, BREAK
+ *   PATCH + OCTAVE- / +      the previous / next part (its first instrument)
+ *   < / >                    what OCT- / OCT+ were: the bars (16 steps at a time), a 303 keyboard's octave,
+ *                            TB-3PO's mutate / new line, HOME's pattern bank
+ *   PATCH + < / >            the previous / next pattern (all parts, at the end of the bar)
+ *   K2 K3 K4 (top right)     the selected instrument's FILTER (middle off, left low-pass, right high-pass),
+ *                            RESONANCE and TONE (a drum: its DECAY; a 303: CUTOFF, RESO, ENV MOD; BREAK: PITCH)
+ *   PATCH + K2 / K3 / K4     tempo / part / pattern (X0X's SELECT, ALGORITHM, PRESETS while PATCH is held)
+ *   KNOB BANK                tap: the pads mute (lit while on); hold: mute while held
+ *   MUTE pads                1-11 the tracks of the kit on screen, 12-16 the parts 909 808 303A 303B BREAK
+ *   PATCH + KNOB BANK        unmute everything
+ *   mod wheel                on a drum or the BREAK: a high-pass riser on that instrument; on a 303 as before
+ * In a list, a question or GLO, K2..K4 are SELECT, ALGORITHM and PRESETS again. */
+
+#include "../dsp/drum808.h"
+#include "../dsp/md_filter.h"
+
+enum { MDI_N = 25, MDI_303A = 22, MDI_303B = 23, MDI_BRK = 24 };
+static const uint8_t MD_ORD909[11] = {DR_BD, DR_SD, DR_CP, DR_CH, DR_OH, DR_LT, DR_MT, DR_HT, DR_RS, DR_CR, DR_RD};
+static const uint8_t MD_ORD808[11] = {D8_BD, D8_SD, D8_CP, D8_CH, D8_OH, D8_LT, D8_MT, D8_HT, D8_RS, D8_CY, D8_CB};   /* the 909's pad places */
+static int8_t md_pos[MDF_N];          /* each instrument's filter: -63..63, 0 off (not saved: a set starts clean) */
+static uint8_t md_res[MDF_N];
+static uint8_t md_wheel;              /* the mod wheel, 0..127 (smk_wheels) */
+
+static int md_inst(void)                               /* the selected instrument, 0..24 */
+{
+    int k;
+    if (ui.part == PART_303A)
+        return MDI_303A;
+    if (ui.part == PART_303B)
+        return MDI_303B;
+    if (ui.part == PART_BRK)
+        return MDI_BRK;
+    for (k = 0; k < 11; k++)
+        if ((ui.part == PART_909 ? MD_ORD909[k] : MD_ORD808[k]) == ui.sel[ui.part])
+            return ui.part * 11 + k;
+    return ui.part * 11;
+}
+
+static int md_inst_flt(int i)                          /* its filter (md_flt), -1: a 303 (its own filter) */
+{
+    if (i < 11)
+        return MDF_909 + MD_ORD909[i];
+    if (i < 22)
+        return MDF_808 + MD_ORD808[i - 11];
+    return i == MDI_BRK ? MDF_BRK : -1;
+}
+
+static void md_name(char *t, int i)
+{
+    char *q;
+    if (i < 22) {
+        q = put_s(t, i < 11 ? "909 " : "808 ");
+        put_s(q, engine_voice_name(i < 11 ? T_909 : T_808, i < 11 ? MD_ORD909[i] : MD_ORD808[i - 11]));
+    } else
+        put_s(t, PART_N[i - 20]);
+}
+
+static void md_select(int i)
+{
+    char t[28];
+    i = (i % MDI_N + MDI_N) % MDI_N;
+    if (i < 22) {
+        int km = i < 11 ? PART_909 : PART_808;
+        ui.part = (uint8_t)km;
+        ui.sel[km] = i < 11 ? MD_ORD909[i] : MD_ORD808[i - 11];
+        if (!seq.playing || proj.set.keysound)
+            engine_drum(km, ui.sel[km], 0.75f);
+    } else
+        ui.part = (uint8_t)(i - 20);
+    if (ui.view == V_GEN && !is_303())
+        set_view(V_PART);
+    else if (ui.view == V_HOME || ui.view == V_SONG || ui.view == V_FX || ui.view == V_PERF)
+        set_view(V_PART);
+    ui.outline_ok = 0;
+    if (ui.view == V_MIX)
+        ui.mixsel = ui.part;
+    build_pages();
+    md_name(t, i);
+    say(t, 0);
+}
+
+static void md_flt_apply(int f)
+{
+    int p = md_pos[f];
+    if (md_wheel && f >= 0) {                             /* the riser: high-pass up from where it is */
+        int w = md_wheel * 63 / 127;
+        p = p > w ? p : w;
+    }
+    md_flt_set(&md_flt[f], p, md_res[f]);
+}
+
+static int md_decay_param(int target, int voice)       /* a track's "tone" knob: its decay (or tail, or tune) */
+{
+    static const char *const PREF[3] = {"Decay", "Tail", "Tune"};
+    int k, i, n = engine_nparams(target, voice);
+    for (k = 0; k < 3; k++)
+        for (i = 0; i < n; i++) {
+            const x0x_param_t *d = engine_param(target, voice, i);
+            if (d && strcmp_s(d->name, PREF[k]) == 0)
+                return i;
+        }
+    return 0;
+}
+
+static void md_say_val(const char *who, const char *what, int v, int lohi)
+{
+    char t[28], *q = put_s(put_s(put_s(t, who), " "), what);
+    q = put_s(q, " ");
+    if (lohi) {
+        if (v == 0)
+            put_s(q, "OFF");
+        else
+            put_i(put_s(q, v < 0 ? "LP " : "HP "), (v < 0 ? -v : v) * 100 / 63);
+    } else
+        put_i(q, v);
+    say(t, 0);
+}
+
+static uint32_t md_len(const char *s)
+{
+    uint32_t n = 0;
+    while (s[n])
+        n++;
+    return n;
+}
+
+static void md_pref_turn(pref_t r, int e, int role, const char *who)
+{
+    const x0x_param_t *d = pref_desc(r);
+    char num[16], unit[8], t[28], *q;
+    int v;
+    if (!d)
+        return;
+    v = pref_get(r) + accel(role, e, d->max);
+    v = v < 0 ? 0 : v > d->max ? d->max : v;
+    pref_set(r, v);
+    motion_touch(r);
+    ui.act_t = plat_ms();
+    pref_value(r, num, unit);
+    q = put_s(put_s(put_s(put_s(t, who), " "), d->name), " ");
+    if (md_len(num) + md_len(unit) + (uint32_t)(q - t) < 27u)
+        put_s(put_s(q, num), unit);
+    say(t, 0);
+}
+
+/* K2..K4: the selected instrument's filter, resonance, tone */
+static void md_knob(int which, int e)
+{
+    int i = md_inst(), f = md_inst_flt(i);
+    char who[16];
+    md_name(who, i);
+    if (i == MDI_303A || i == MDI_303B) {
+        static const uint8_t P3[3] = {BASS303_CUTOFF, BASS303_RESO, BASS303_ENVMOD};
+        md_pref_turn(PR(R_ENG, T_303, i - MDI_303A, P3[which]), e, EN_SELECT + which, who);
+        return;
+    }
+    if (which == 0) {                                     /* FILTER: one detent each, it rests at the middle */
+        int p = md_pos[f], s = accel(EN_SELECT, e, 126), n = p + s;
+        if ((p < 0 && n > 0) || (p > 0 && n < 0))
+            n = 0;
+        n = n < -63 ? -63 : n > 63 ? 63 : n;
+        md_pos[f] = (int8_t)n;
+        md_flt_apply(f);
+        md_say_val(who, "FILTER", n, 1);
+    } else if (which == 1) {
+        int r = md_res[f] + accel(EN_ALGO, e, 127);
+        md_res[f] = (uint8_t)(r < 0 ? 0 : r > 127 ? 127 : r);
+        md_flt_apply(f);
+        md_say_val(who, "RESO", md_res[f] * 100 / 127, 0);
+    } else if (i == MDI_BRK) {
+        md_pref_turn(PR(R_ENG, T_BRK, 0, BRK_PITCH), e, EN_PRESET, who);
+    } else {
+        int t = i < 11 ? T_909 : T_808, v = i < 11 ? MD_ORD909[i] : MD_ORD808[i - 11];
+        md_pref_turn(PR(R_ENG, t, v, md_decay_param(t, v)), e, EN_PRESET, who);
+    }
+}
+
+/* ------------------------------------------------------------------ mutes --- */
+static uint8_t md_mute_on, md_mute_used, md_kb_held;
+static uint32_t md_kb_t0;
+static int md_mute_kit(void) { return ui.part == PART_808 ? 1 : 0; }
+
+static void md_mute_pad(int w)                         /* pad w (0 = pad 1, top left) */
+{
+    ui.act_t = plat_ms();
+    if (w < 11) {
+        int km = md_mute_kit();
+        mute_track(km, km ? MD_ORD808[w] : MD_ORD909[w]);
+    } else if (w < 16)
+        mute_part(w - 11);
+}
+
+static void md_mute_leds(void)
+{
+    uint32_t w;
+    int km = md_mute_kit();
+    uint16_t kc = PART_COL[km];
+    for (w = 0; w < SMK_NPAD; w++) {
+        uint16_t c;
+        int muted, sh;
+        if (w < 11) {
+            muted = track_muted(km, km ? MD_ORD808[w] : MD_ORD909[w]) || part_muted(km);
+            c = kc;
+        } else if (w < 16) {
+            muted = part_muted((int)w - 11);
+            c = PART_COL[w - 11];
+        } else
+            continue;
+        sh = muted ? 4 : 1;
+        if (muted)
+            c = RGB(255, 40, 30);                        /* muted: a dim red, so the playing ones stand out */
+        padled_set(w, (uint8_t)(((uint32_t)(c >> 11) * 255u / 31u) >> sh), (uint8_t)(((uint32_t)((c >> 5) & 63u) * 255u / 63u) >> sh),
+                   (uint8_t)(((uint32_t)(c & 31u) * 255u / 31u) >> sh));
+    }
+    padled_flush();
+}
+
+/* ----------------------------------------------------------- every frame --- */
+static uint32_t md_prev_raw;
+static uint32_t md_prev_pads;
+
+static void md_frame(void)
+{
+    uint32_t raw = fm1_in.buttons, pressed = raw & ~md_prev_raw, released = ~raw & md_prev_raw;
+    int home = (plat_buttons() >> B_HOME) & 1;
+    uint32_t r;
+    md_prev_raw = raw;
+    /* the knobs: X0X's own while a list, a question, GLO or PATCH wants them */
+    md_nav = (uint8_t)(ui.overlay != O_NONE || ui.view == V_GLO || ui.view == V_PERF || home);
+    if (!md_nav) {
+        int k;
+        for (k = 0; k < 3; k++) {
+            int32_t e = fm1_enc_take(panel.enc[EN_SELECT + k]) * panel.dir[EN_SELECT + k];
+            if (e)
+                md_knob(k, (int)e);
+        }
+    }
+    /* OCTAVE- / +: the instrument; with PATCH the part */
+    for (r = FM1_BTN_OCT_DOWN; r <= FM1_BTN_OCT_UP; r++) {
+        int up = r == FM1_BTN_OCT_UP, i;
+        uint32_t lb;
+        if (!((pressed >> r) & 1u))
+            continue;
+        for (lb = 0; lb < NB && panel.btn[lb] != r; lb++)
+            ;
+        if (lb < NB)                                      /* calibrated as an X0X button: leave it */
+            continue;
+        ui.act_t = plat_ms();
+        if (home) {
+            int p = ui.part + (up ? 1 : -1);
+            ui.btn_used |= 1u << B_HOME;
+            p = (p + NPARTS) % NPARTS;
+            md_select(p < 2 ? p * 11 : p + 20);
+        } else {
+            i = md_inst() + (up ? 1 : -1);
+            md_select(i);
+        }
+    }
+    /* PATCH + < / >: the pattern before / after (all parts, cued to the bar) */
+    for (r = SMK_BTN_LEFT; r <= SMK_BTN_RIGHT; r++) {
+        if ((pressed >> r) & 1u && home) {
+            int c = seq_cue_of(&seq, PART_909), p = (c >= 0 ? c : seq.ppat[PART_909]) + (r == SMK_BTN_RIGHT ? 1 : -1);
+            char t[16];
+            p = (p + NPAT) % NPAT;
+            ui.btn_used |= 1u << B_HOME;
+            seq_chain(&seq, 0, 0);
+            seq_cue(&seq, p);
+            ui.pbank = (uint8_t)(p / 16);
+            put_i(put_s(t, seq.playing ? "NEXT: P" : "PATTERN P"), p + 1);
+            say(t, 0);
+        }
+    }
+    /* KNOB BANK: the mute pads (tap: on / off; hold: while held); PATCH + it: unmute all */
+    if ((pressed >> SMK_BTN_KNOB_BANK) & 1u) {
+        if (home) {
+            ui.btn_used |= 1u << B_HOME;
+            seq.mute = 0;
+            seq.vmute = 0;
+            say("ALL UNMUTED", 0);
+        } else {
+            md_kb_held = 1;
+            md_kb_t0 = plat_ms();
+            md_mute_used = 0;
+            if (!md_mute_on) {
+                md_mute_on = 2;                           /* 2: on since this press (a hold, or a tap that keeps it) */
+                say("MUTE PADS: TRACKS + PARTS", 0);   /* (say: 27 chars) */
+            }
+        }
+    }
+    if ((released >> SMK_BTN_KNOB_BANK) & 1u && md_kb_held) {
+        md_kb_held = 0;
+        if (md_mute_on == 2)                              /* just switched on: a tap keeps it, a played hold not */
+            md_mute_on = md_mute_used ? 0 : 1;
+        else if (!md_mute_used)
+            md_mute_on = 0;                               /* on before: a tap switches it off */
+        if (!md_mute_on)
+            say("MUTE OFF", 0);
+    }
+    md_pads_muting = md_mute_on != 0;
+    if (md_mute_on) {
+        uint32_t pads = fm1_in.pnotes, pp = pads & ~md_prev_pads, w;
+        for (w = 0; w < SMK_NPAD; w++)
+            if ((pp >> SMK_WHITE_NOTE[w]) & 1u) {
+                md_mute_pad((int)w);
+                md_mute_used = 1;
+            }
+        md_prev_pads = pads;
+    } else
+        md_prev_pads = fm1_in.pnotes;
+    /* the mod wheel's riser follows the instrument on screen */
+    {
+        static int last_f = -1;
+        static uint8_t last_w;
+        int f = md_inst_flt(md_inst());
+        if (f != last_f && last_f >= 0 && last_w) {       /* another instrument: the last one as set */
+            uint8_t keep = md_wheel;
+            md_wheel = 0;
+            md_flt_apply(last_f);
+            md_wheel = keep;
+        }
+        if (f >= 0 && (md_wheel != last_w || f != last_f))
+            md_flt_apply(f);
+        last_f = f;
+        last_w = md_wheel;
+    }
+}
+
+static void md_wheel_set(int mw) { md_wheel = (uint8_t)mw; }
