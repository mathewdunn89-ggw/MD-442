+/* --------------------------------------------------------------- drum pads --- */
+static uint8_t md_drums;                               /* PATCH + FADER BANK: the pads play the kit */
+static uint16_t md_drum_lit;                           /* pads held */
+static void md_drum_pad(int w, int vel)                /* pads 1-11: the kit on screen, 12-16: the other's BD SD CP CH OH */
+{
+    int km = md_mute_kit(), v;
+    float f = (float)(vel < 1 ? 1 : vel) / 127.0f;
+    if (w >= 11)
+        km ^= 1;
+    v = km ? MD_ORD808[w < 11 ? w : w - 11] : MD_ORD909[w < 11 ? w : w - 11];
+    engine_drum(km, v, f);
+    ui.act_t = plat_ms();
+    if (km == ui.part && ui.sel[km] != v) {             /* the pad played is the one the knobs shape */
+        ui.sel[km] = (uint8_t)v;
+        build_pages();
+    }
+    if (ui.rec && seq.playing) {                       /* to the nearest step: a late half goes to the next */
+        int t = TRK_DRUM + km, s = eng_step[t];
+        uint32_t L = seq_step_q8(&seq, pat_of(km)->drum[km].rate & 3);
+        dpart_t *d = &pat_of(km)->drum[km];
+        if (seq.t[t].to_next != 0xFFFFFFFFu && seq.t[t].to_next < L / 2u) {
+            uint32_t l = fm1__lock();
+            s = seq_next_step(&seq, t, s);
+            seq.skip1 |= 1u << (km * NDRUM + v);       /* heard now: the step does not play it again */
+            fm1__unlock(l);
+        }
+        sm_set(d->hit[v], s);
+        if (f >= 0.9f)
+            sm_set(d->accent, s);
+        mark_dirty();
+    }
+}
+
+static void md_drum_leds(void)
+{
+    uint32_t w;
+    int km = md_mute_kit();
+    for (w = 0; w < SMK_NPAD; w++) {
+        int k = w < 11 ? km : km ^ 1, v = k ? MD_ORD808[w < 11 ? w : w - 11] : MD_ORD909[w < 11 ? w : w - 11];
+        uint16_t c = PART_COL[k];
+        int sh = (md_drum_lit >> w) & 1u ? 0 : (k == ui.part && ui.sel[k] == v) ? 1 : w < 11 ? 3 : 4;
+        padled_set(w, (uint8_t)(((uint32_t)(c >> 11) * 255u / 31u) >> sh), (uint8_t)(((uint32_t)((c >> 5) & 63u) * 255u / 63u) >> sh),
+                   (uint8_t)(((uint32_t)(c & 31u) * 255u / 31u) >> sh));
+    }
+    padled_flush();
+}
