+         acc909="....x.......x...",
+         brk=dict(slot=0, steps="gggggggggggggggg", complex=0, level=70),
+         bass=dict(root=38, row=["0", ".", ".", ".", ".", ".", ".", "0", ".", ".", "s3", "5", ".", ".", ".", "."])),
+    dict(name="DUSTY", swing=36,
