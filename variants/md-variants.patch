new file mode 100644
index 0000000..bebb2f4
--- /dev/null
+++ b/firmware/src/dsp/md_filter.h
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* MD|442 performance filters: one state-variable filter (TPT / Zavalishin) per instrument, each
+ * 909 and 808 track, the BREAK; the 303s use their own filter. Bipolar, as a DJ filter: the
+ * knob's middle is off (nothing runs), left a low-pass closing down, right a high-pass opening up.
+ *
+ * The main loop computes the coefficients (md_flt_set) into the half the ISR is not reading and then
+ * flips `cur` (one byte); the ISR (and the second core, for the 808 and the break) runs md_flt_run on
+ * a voice's output before its pan and sends. Off costs one byte test a voice and block. */
+#pragma once
+#include <stdint.h>
+#include "fastmath.h"
+
+#ifndef MD_FILTER
+#define MD_FILTER 0
+#endif
+
+typedef struct {
+    float a1, a2, a3, k;
+} md_flt_coef_t;
+typedef struct {
+    volatile uint8_t on;        /* 0 off, 1 low-pass, 2 high-pass */
+    volatile uint8_t cur;       /* the coefficient half in use */
+    volatile uint8_t reset;     /* the main loop asks for a clean start (the ISR clears) */
+    uint8_t rsv;
+    md_flt_coef_t c[2];
+    float ic1, ic2;
+} md_flt_t;
+
+/* instruments: 0..10 the 909's tracks, 11..21 the 808's, 22 the BREAK */
+enum { MDF_909 = 0, MDF_808 = 11, MDF_BRK = 22, MDF_N = 23 };
+extern md_flt_t md_flt[MDF_N];
+
+static inline void md_flt_run(md_flt_t *f, float *x, int n)
+{
+    const md_flt_coef_t *c;
+    float ic1, ic2;
+    int i;
+    if (!f->on)
+        return;
+    if (f->reset) {
+        f->ic1 = f->ic2 = 0.0f;
+        f->reset = 0;
+    }
+    c = &f->c[f->cur & 1u];
+    ic1 = f->ic1;
+    ic2 = f->ic2;
+    if (f->on == 1) {
+        for (i = 0; i < n; i++) {
+            float v3 = x[i] - ic2, v1 = c->a1 * ic1 + c->a2 * v3, v2 = ic2 + c->a2 * ic1 + c->a3 * v3;
+            ic1 = 2.0f * v1 - ic1;
+            ic2 = 2.0f * v2 - ic2;
+            x[i] = v2;
+        }
+    } else {
+        for (i = 0; i < n; i++) {
+            float v3 = x[i] - ic2, v1 = c->a1 * ic1 + c->a2 * v3, v2 = ic2 + c->a2 * ic1 + c->a3 * v3;
+            ic1 = 2.0f * v1 - ic1;
+            ic2 = 2.0f * v2 - ic2;
+            x[i] = x[i] - c->k * v1 - v2;
+        }
+    }
+    /* a denormal / runaway guard: the states stay finite */
+    if (!(ic1 > -1e6f && ic1 < 1e6f) || !(ic2 > -1e6f && ic2 < 1e6f))
+        ic1 = ic2 = 0.0f;
+    f->ic1 = ic1;
+    f->ic2 = ic2;
+}
+
+/* one sample (the 909's voices emit sample by sample) */
+static inline float md_flt_tick(md_flt_t *f, float x)
+{
+    const md_flt_coef_t *c = &f->c[f->cur & 1u];
+    float v3 = x - f->ic2, v1 = c->a1 * f->ic1 + c->a2 * v3, v2 = f->ic2 + c->a2 * f->ic1 + c->a3 * v3;
+    f->ic1 = 2.0f * v1 - f->ic1;
+    f->ic2 = 2.0f * v2 - f->ic2;
+    return f->on == 1 ? v2 : x - c->k * v1 - v2;
+}
+
+/* main loop: pos -63..63 (0 off; < 0 low-pass, > 0 high-pass), res 0..127 */
+static inline void md_flt_set(md_flt_t *f, int pos, int res)
+{
+    md_flt_coef_t *c;
+    float t, fc, g, k;
+    uint8_t nxt;
+    if (pos == 0) {
+        f->on = 0;
+        return;
+    }
+    if (pos < 0) {                       /* low-pass: 18 kHz at -1 down to 70 Hz at -63 */
+        t = (float)(-pos - 1) / 62.0f;
+        fc = 18000.0f * fm_exp2f(-8.0f * t);
+    } else {                             /* high-pass: 25 Hz at +1 up to 7 kHz at +63 */
+        t = (float)(pos - 1) / 62.0f;
+        fc = 25.0f * fm_exp2f(8.13f * t);
+    }
+    g = fm_tanf(3.14159265f * fc / 44100.0f);
+    k = 2.0f - 1.7f * (float)(res < 0 ? 0 : res > 127 ? 127 : res) / 127.0f;   /* Q 0.5 .. ~3.3 */
+    nxt = (uint8_t)((f->cur & 1u) ^ 1u);
+    c = &f->c[nxt];
+    c->k = k;
+    c->a1 = 1.0f / (1.0f + g * (g + k));
+    c->a2 = g * c->a1;
+    c->a3 = g * c->a2;
+    if (!f->on)
+        f->reset = 1;
+    f->cur = nxt;
+    f->on = (uint8_t)(pos < 0 ? 1 : 2);
+}
