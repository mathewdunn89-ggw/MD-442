diff --git a/firmware/src/app/md442_presets.h b/firmware/src/app/md442_presets.h
index 9bbe9f6..c4c807c 100644
--- a/firmware/src/app/md442_presets.h
+++ b/firmware/src/app/md442_presets.h
@@ -53,4 +53,67 @@ static void md442_load_preset(pattern_t *p, const md442_preset_t *m)
         }
     }
     p->swing = (uint8_t)(m->swing * 132 / 100 > 100 ? 100 : m->swing * 132 / 100);   /* MD|442 shuffle 50 + swing * .33 % */
+#if BOARD_SMK37
+    {   /* MD: CHORDS (303 B, a minor 7th a key) plays MD|442's dub stab where it had one: Deep House's
+         * off-beats, Dub Techno's delayed stab, an octave over the bass */
+        static const uint16_t STAB[MD442_NPRESETS] = {0, 0, 0, 0, 0x4444, 0, 0x4408};
+        int k = (int)(m - MD442_PRESETS);
+        bpart_t *c = &p->bass[1];
+        if (k >= 0 && k < MD442_NPRESETS && STAB[k]) {
+            c->len = 16;
+            for (i = 0; i < 16; i++) {
+                c->step[i].note = (uint8_t)(m->root_midi + 12);
+                c->step[i].flags = (STAB[k] >> i) & 1u ? (uint8_t)(G_NOTE | (i == 3 ? BS_ACCENT : 0)) : G_REST;
+            }
+        }
