+/* SPDX-License-Identifier: GPL-3.0-only */
+/* MD|442's three firmwares (MD_VARIANT, tools/build.py): one engine, one PERFORM layout, their own
+ * patterns, sound and samples. */
+#pragma once
+#ifndef MD_VARIANT
+#define MD_VARIANT 442
+#endif
+#if MD_VARIANT == 187
+#define MD_NAME "MD|187"
+#define MD_TAG "HIP-HOP  BY MATHEW"
+#define MD_PALETTE 1                     /* amber */
+#elif MD_VARIANT == 888
+#define MD_NAME "MD|888"
+#define MD_TAG "HARD TECHNO  BY MATHEW"
+#define MD_PALETTE 3                     /* red */
+#else
+#define MD_NAME "MD|442"
+#define MD_TAG "BY MATHEW  NEST GROUP"
+#define MD_PALETTE 0                     /* MD|442 green */
+#endif
+
+/* settings_t rsv[0]: the MD firmware a saved project belongs to (0 = MD442, as every older project) */
+#if defined(MD_VARIANT) && MD_VARIANT == 187
+#define MD_SET_ID 1u
+#elif defined(MD_VARIANT) && MD_VARIANT == 888
+#define MD_SET_ID 2u
+#else
+#define MD_SET_ID 0u
+#endif
