+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""MD|187 and MD|888's sample banks: every sound synthesised here from scratch (no recordings, nothing
+taken from a record), written as the one-bar / two-bar WAVs tools/gen_break_bank.py compiles in
+(X0X_BREAK_BANK=DIR ./build.sh). Deterministic (fixed seeds).
+
+  tools/md_gen_samples.py 187 OUTDIR     MD|187 (96 BPM): BOOMBP (a dusty break), DRUMS, STABS, VOX (8 one-shots each)
+  tools/md_gen_samples.py 888 OUTDIR     MD|888: RUMBLE, GABBA, TRANCE (2 bars), HITS
+
+A one-shot bank is a loop of 8 equal slices: the BREAK part's slice 1..8, so a pattern step plays one
+(the slice set on that step) and the keyboard's black keys 1-8 play them live."""
+import struct
+import sys
+from pathlib import Path
+
+import numpy as np
+
+SR = 22050          # the bank's rate (gen_break_bank.py)
+OS = 2              # synthesise at 44.1 kHz, then decimate
+FS = SR * OS
+
+
+# ------------------------------------------------------------------ tools ---
+def t_(n):
+    return np.arange(n) / FS
+
+
+def env_exp(n, tau):
+    return np.exp(-t_(n) / max(tau, 1e-4))
+
+
+def env_ad(n, a, tau):
+    t = t_(n)
+    e = np.exp(-np.maximum(t - a, 0) / max(tau, 1e-4))
+    if a > 0:
+        e = np.where(t < a, t / a, e)
+    return e
+
+
+def onepole_lp(x, fc):
+    a = np.exp(-2 * np.pi * fc / FS)
+    y = np.empty_like(x)
+    s = 0.0
+    for i in range(len(x)):
+        s = (1 - a) * x[i] + a * s
+        y[i] = s
+    return y
+
+
+def svf(x, fc, q=0.7, mode="lp"):
+    """TPT state-variable filter; fc may be an array (a sweep)"""
+    fc = np.broadcast_to(np.asarray(fc, dtype=float), x.shape)
+    k = 1.0 / q
+    ic1 = ic2 = 0.0
+    y = np.empty_like(x)
+    for i in range(len(x)):
+        g = np.tan(np.pi * min(fc[i], FS * 0.45) / FS)
+        a1 = 1 / (1 + g * (g + k))
+        a2 = g * a1
+        a3 = g * a2
+        v3 = x[i] - ic2
+        v1 = a1 * ic1 + a2 * v3
+        v2 = ic2 + a2 * ic1 + a3 * v3
+        ic1 = 2 * v1 - ic1
+        ic2 = 2 * v2 - ic2
+        y[i] = v2 if mode == "lp" else v1 if mode == "bp" else x[i] - k * v1 - v2
+    return y
+
+
+def fft_filter(x, lo=None, hi=None):
+    """zero-phase brick-ish band limit (fast; for noise colour)"""
+    X = np.fft.rfft(x)
+    f = np.fft.rfftfreq(len(x), 1 / FS)
+    m = np.ones_like(f)
+    if lo:
+        m *= 1 / (1 + (lo / np.maximum(f, 1)) ** 4)
+    if hi:
+        m *= 1 / (1 + (f / hi) ** 4)
+    return np.fft.irfft(X * m, len(x))
+
+
+def bandpass(x, fc, q):
+    return svf(x, fc, q, "bp")
+
+
+def sat(x, drive=1.0):
+    return np.tanh(x * drive) / np.tanh(drive)
+
+
+def crush(x, bits):
+    q = 2 ** (bits - 1)
+    return np.round(x * q) / q
+
+
+def norm(x, peak=0.95):
+    m = np.max(np.abs(x)) + 1e-12
+    return x * (peak / m)
+
+
+def place(buf, x, at, gain=1.0):
+    at = int(at)
+    n = min(len(x), len(buf) - at)
+    if n > 0:
+        buf[at:at + n] += x[:n] * gain
+
+
+def fade_tail(x, ms=8):
+    n = min(len(x), int(FS * ms / 1000))
+    x = x.copy()
+    x[-n:] *= np.linspace(1, 0, n)
+    return x
+
+
+def fit(x, n):
+    """exactly n samples, faded out at the end (a one-shot inside its slice)"""
+    y = np.zeros(n)
+    m = min(n, len(x))
+    y[:m] = x[:m]
+    return fade_tail(y, 6)
+
+
+def room(x, size=0.25, mix=0.2, seed=1, tone=4000):
+    """a small noise-tail room (convolution with decaying filtered noise)"""
+    r = np.random.default_rng(seed)
+    n = int(FS * size)
+    ir = r.standard_normal(n) * np.exp(-t_(n) / (size / 5))
+    ir = fft_filter(ir, 200, tone)
+    ir /= np.sqrt(np.sum(ir ** 2)) + 1e-9
+    wet = np.convolve(x, ir)[: len(x)]
+    return x * (1 - mix) + wet * mix * 2.0
+
+
+def decimate(x):
+    y = fft_filter(x, None, SR * 0.45)
+    return y[::OS]
+
+
+def write_wav(path, x):
+    x = np.clip(x, -1, 1)
+    pcm = b"".join(struct.pack("<h", int(round(v * 32767))) for v in x)
+    path.write_bytes(b"RIFF" + struct.pack("<I", 36 + len(pcm)) + b"WAVEfmt " +
+                     struct.pack("<IHHIIHH", 16, 1, 1, SR, SR * 2, 2, 16) + b"data" + struct.pack("<I", len(pcm)) + pcm)
+
+
+def mtof(m):
+    return 440.0 * 2 ** ((m - 69) / 12)
+
+
+# ------------------------------------------------------------- the drums ---
+def kick(dur=0.5, f0=150, f1=48, sweep=0.045, decay=0.32, click=0.6, drive=2.0, seed=3):
+    n = int(FS * dur)
+    t = t_(n)
+    f = f1 + (f0 - f1) * np.exp(-t / sweep)
+    ph = 2 * np.pi * np.cumsum(f) / FS
+    body = np.sin(ph) * env_ad(n, 0.002, decay)
+    r = np.random.default_rng(seed)
+    clk = fft_filter(r.standard_normal(n), 1500, 7000) * env_exp(n, 0.004) * click
+    return sat(body + clk, drive)
+
+
+def snare(dur=0.35, tone=185, decay=0.12, noise_decay=0.16, snap=0.8, lo=1200, hi=9000, drive=1.6, seed=5):
+    n = int(FS * dur)
+    t = t_(n)
+    r = np.random.default_rng(seed)
+    body = (np.sin(2 * np.pi * tone * t) + 0.5 * np.sin(2 * np.pi * tone * 1.62 * t)) * env_ad(n, 0.001, decay)
+    nz = fft_filter(r.standard_normal(n), lo, hi) * env_ad(n, 0.001, noise_decay) * snap
+    return sat(body * 0.8 + nz, drive)
+
+
+def hat(dur=0.08, decay=0.03, lo=7000, seed=7, open_=False):
+    n = int(FS * dur)
+    r = np.random.default_rng(seed)
+    t = t_(n)
+    metal = sum(np.sign(np.sin(2 * np.pi * f * t)) for f in (317, 421, 538, 691, 853, 1027)) / 6
+    x = fft_filter(r.standard_normal(n) * 0.7 + metal * 0.5, lo, 14000)
+    return x * env_ad(n, 0.0005, decay if not open_ else decay * 6)
+
+
+def shaker(dur=0.12, seed=9):
+    n = int(FS * dur)
+    r = np.random.default_rng(seed)
+    return fft_filter(r.standard_normal(n), 5000, 12000) * env_ad(n, 0.02, 0.035)
+
+
+def clap(dur=0.3, seed=11):
+    n = int(FS * dur)
+    r = np.random.default_rng(seed)
+    nz = fft_filter(r.standard_normal(n), 900, 5000)
+    e = np.zeros(n)
+    for k, d in enumerate((0, 0.009, 0.019, 0.029)):
+        e += np.exp(-np.maximum(t_(n) - d, 0) / (0.006 if k < 3 else 0.09)) * (t_(n) >= d)
+    return sat(nz * e, 1.5)
+
+
+def vinyl(n, seed=13, crackle=0.06, hiss=0.012):
+    r = np.random.default_rng(seed)
+    x = fft_filter(r.standard_normal(n), 2000, 9000) * hiss
+    pops = r.random(n) < (18.0 / FS)
+    x += np.convolve(pops * r.choice([-1, 1], n) * r.uniform(0.3, 1, n), np.exp(-np.arange(60) / 8))[:n] * crackle
+    x += np.sin(2 * np.pi * 0.555 * t_(n)) * 0.004       # the turntable's rumble, a hair
+    return x
+
+
+def dusty(x, bits=12, lp=11000, drive=1.4):
+    """SP-1200 / MPC60 flavour: band-limited, driven, fewer bits"""
+    y = fft_filter(x, 30, lp)
+    y = sat(y, drive)
+    return crush(y, bits)
+
+
+# -------------------------------------------------------- the tonal kit ---
+def rhodes(notes, dur, seed=0):
+    n = int(FS * dur)
+    t = t_(n)
+    x = np.zeros(n)
+    for k, m in enumerate(notes):
+        f = mtof(m) * (1 + 0.0015 * (k - 1))
+        idx = 2.2 * env_exp(n, 0.25)
+        mod = np.sin(2 * np.pi * f * 14 * t) * env_exp(n, 0.02) * 0.4 + np.sin(2 * np.pi * f * t) * idx
+        x += np.sin(2 * np.pi * f * t + mod) * env_ad(n, 0.003, 0.9)
+    x *= 1 + 0.15 * np.sin(2 * np.pi * 5.2 * t)          # a little tremolo
+    return x / len(notes)
+
+
+def brass(notes, dur, bright=3500, seed=0):
+    n = int(FS * dur)
+    t = t_(n)
+    x = np.zeros(n)
+    for k, m in enumerate(notes):
+        for d in (-0.004, 0.0, 0.005):
+            f = mtof(m) * (1 + d)
+            x += 2 * ((f * t + 0.13 * k) % 1.0) - 1
+    fc = 300 + bright * env_ad(n, 0.025, 0.12)
+    x = svf(x / (3 * len(notes)), fc, 0.9)
+    return sat(x * env_ad(n, 0.012, 0.22) * 2.0, 1.5)
+
+
+def strings(notes, dur, seed=0):
+    n = int(FS * dur)
+    t = t_(n)
+    x = np.zeros(n)
+    for m in notes:
+        for d in (-0.006, -0.002, 0.003, 0.007):
+            x += 2 * ((mtof(m) * (1 + d) * t + d * 40) % 1.0) - 1
+    x = svf(x / (4 * len(notes)), 2600, 0.6)
+    return x * env_ad(n, 0.03, 0.25)
+
+
+def organ(notes, dur):
+    n = int(FS * dur)
+    t = t_(n)
+    x = np.zeros(n)
+    for m in notes:
+        f = mtof(m)
+        x += np.sin(2 * np.pi * f * t) + 0.6 * np.sin(4 * np.pi * f * t) + 0.35 * np.sin(6 * np.pi * f * t)
+    x = sat(x / len(notes) * 0.8, 2.0)
+    return x * env_ad(n, 0.004, 0.3) * (1 + 0.2 * np.sin(2 * np.pi * 6.5 * t))
+
+
+def supersaw(notes, dur, cut=6000, decay=0.22, seed=0):
+    n = int(FS * dur)
+    t = t_(n)
+    r = np.random.default_rng(seed)
+    x = np.zeros(n)
+    for m in notes:
+        for d in np.linspace(-0.018, 0.018, 7):
+            ph = r.random()
+            x += 2 * ((mtof(m) * (1 + d) * t + ph) % 1.0) - 1
+    x /= 7 * len(notes)
+    fc = 500 + cut * env_ad(n, 0.002, 0.09)
+    x = svf(x, fc, 1.1)
+    return x * env_ad(n, 0.002, decay)
+
+
+# ------------------------------------------------------------- the voice ---
+VOWELS = {"a": (800, 1150, 2900), "o": (450, 800, 2830), "e": (400, 2000, 2550), "u": (325, 700, 2530),
+          "i": (300, 2300, 3000), "ae": (660, 1700, 2400), "uh": (600, 1040, 2250)}
+
+
+def voice(segments, f0=170, dur=0.3, seed=21, breath=0.0, gruff=0.0):
+    """segments: [(vowel, seconds)], gliding between them; a glottal saw through 3 formants"""
+    n = int(FS * dur)
+    t = t_(n)
+    r = np.random.default_rng(seed)
+    tot = sum(s for _, s in segments)
+    # the formant tracks
+    F = np.zeros((3, n))
+    pos = 0
+    for k, (v, s) in enumerate(segments):
+        m = int(n * s / tot)
+        a = np.array(VOWELS[v], dtype=float)
+        b = np.array(VOWELS[segments[min(k + 1, len(segments) - 1)][0]], dtype=float)
+        for j in range(3):
+            F[j, pos:pos + m] = np.linspace(a[j], b[j], m) if k + 1 < len(segments) else a[j]
+        pos += m
+    F[:, pos:] = F[:, pos - 1:pos]
+    pitch = f0 * (1 + 0.08 * np.exp(-t / 0.05)) * (1 - 0.06 * t / dur) * (1 + 0.012 * r.standard_normal(n).cumsum() / np.sqrt(n))
+    ph = np.cumsum(pitch) / FS
+    src = (2 * (ph % 1.0) - 1) ** 3 * 1.5 + r.standard_normal(n) * (0.08 + breath)
+    if gruff:
+        src *= 1 + gruff * np.sin(2 * np.pi * pitch * 0.5 * t)
+    y = sum(bandpass(src, F[j], (6, 9, 11)[j]) * (1.0, 0.6, 0.3)[j] for j in range(3))
+    return sat(y * env_ad(n, 0.015, dur * 0.35) * 1.6, 1.3)
+
+
+def consonant(kind, dur=0.06, seed=31):
+    n = int(FS * dur)
+    r = np.random.default_rng(seed)
+    if kind == "h":
+        return fft_filter(r.standard_normal(n), 900, 5000) * env_ad(n, 0.01, 0.025) * 0.5
+    if kind == "ch":
+        return fft_filter(r.standard_normal(n), 2500, 8000) * env_ad(n, 0.002, 0.03) * 0.7
+    if kind == "s":
+        return fft_filter(r.standard_normal(n), 4500, 10000) * env_ad(n, 0.01, 0.05) * 0.5
+    return np.zeros(n)
+
+
+def word(cons, segs, f0, dur, seed, **kw):
+    c = consonant(cons, 0.05, seed + 1) if cons else np.zeros(0)
+    v = voice(segs, f0, dur - len(c) / FS, seed, **kw)
+    return np.concatenate([c, v])
+
+
+def scratch(dur, seed=41):
+    """a baby scratch on a vocal 'ahh': the record pushed forth and back"""
+    n = int(FS * dur)
+    src = voice([("a", 1.0)], 150, 1.2, seed)
+    t = t_(n)
+    speed = np.sin(2 * np.pi * t / dur * 2) * 2.2
+    pos = np.clip(np.cumsum(speed) / FS * FS + FS * 0.25, 0, len(src) - 2)
+    i = pos.astype(int)
+    fr = pos - i
+    x = src[i] * (1 - fr) + src[i + 1] * fr
+    x *= np.minimum(1, np.abs(speed) * 1.5)
+    return sat(x * 1.5, 1.5)
+
+
+# ------------------------------------------------------------- the banks ---
+def bar_len(bpm, bars=1):
+    return int(round(FS * 240.0 / bpm * bars))
+
+
+def one_shots(shots, bpm, bars=1, gains=None):
+    """8 one-shots, each in its slice, each brought to the same peak (times gains[k])"""
+    n = bar_len(bpm, bars)
+    s = n // 8
+    y = np.zeros(n)
+    for k, x in enumerate(shots):
+        place(y, norm(fit(x, s), 0.9 * (gains[k] if gains else 1.0)), k * s)
+    return y
+
+
+def bank_187():
+    bpm = 96
+    out = {}
+    # BOOMBAP: one dusty bar, swung 16ths (MPC 58 %)
+    n = bar_len(bpm)
+    s16 = n / 16
+    sw = 0.16 * s16
+    y = np.zeros(n)
+    k1 = kick(0.45, 140, 50, 0.04, 0.28, 0.7, 2.6, 3)
+    k2 = kick(0.35, 120, 52, 0.035, 0.2, 0.4, 2.2, 4)
+    sn = room(snare(0.32, 190, 0.09, 0.17, 1.0, 1300, 8000, 2.0, 5), 0.3, 0.25, 6)
+    gh = snare(0.12, 210, 0.04, 0.05, 0.6, 1800, 7000, 1.4, 8) * 0.28
+    for st, x, g in ((0, k1, 1.0), (7, k2, 0.8), (10, k1, 0.9), (13, k2, 0.5), (4, sn, 1.0), (12, sn, 1.0),
+                     (6, gh, 1.0), (15, gh, 1.0), (9, gh, 0.6)):
+        place(y, x, st * s16 + (sw if st % 2 else 0), g)
+    for st in range(0, 16, 2):
+        place(y, hat(0.08, 0.025 if st % 4 else 0.035, 6500, 7 + st), st * s16, 0.32 if st % 4 else 0.42)
+    for st in (3, 11):
+        place(y, hat(0.05, 0.015, 8000, 30 + st), st * s16 + sw, 0.14)
+    place(y, hat(0.5, 0.03, 6000, 77, open_=True), 14 * s16, 0.22)
+    y = dusty(y + vinyl(n, 13, 0.05, 0.01), 12, 10500, 1.6)
+    out["BOOMBP"] = (y, 1)
+    # DRUMS: 8 one-shots: kick, kick 2, snare, rim snare, hat, open hat, shaker, clap
+    shots = [kick(0.33, 150, 50, 0.04, 0.24, 0.8, 2.8, 51), kick(0.33, 110, 44, 0.05, 0.3, 0.3, 2.0, 52),
+             room(snare(0.33, 195, 0.08, 0.15, 1.1, 1200, 8000, 2.2, 53), 0.25, 0.25, 54),
+             snare(0.25, 330, 0.03, 0.07, 0.7, 2500, 9000, 2.0, 55), hat(0.1, 0.022, 6500, 56),
+             hat(0.33, 0.03, 6000, 57, open_=True), shaker(0.2, 58), room(clap(0.33, 59), 0.25, 0.3, 60)]
+    out["DRUMS"] = (dusty(one_shots(shots, bpm, 1, [1, 1, 1, 0.8, 0.5, 0.55, 0.45, 0.85]) + vinyl(bar_len(bpm), 61, 0.02, 0.006), 12, 11000, 1.3), 1)
+    # STABS: D minor, 8 chords (Rhodes, horns, strings, organ)
+    dm9, gm9, bbmaj7, a7b9 = [50, 53, 57, 60, 64], [55, 58, 62, 65, 69], [58, 62, 65, 69], [57, 61, 64, 67, 70]
+    shots = [rhodes(dm9, 0.33), rhodes(gm9, 0.33), brass([62, 65, 69], 0.33), brass([60, 64, 67, 70], 0.33),
+             strings(bbmaj7, 0.33), strings(a7b9, 0.33), organ([50, 57, 62, 65], 0.33), rhodes([45, 52, 55, 60], 0.33)]
+    shots = [room(sat(x * 1.6, 1.2), 0.3, 0.2, 70 + k) for k, x in enumerate(shots)]
+    out["STABS"] = (dusty(one_shots(shots, bpm), 12, 10000, 1.2), 1)
+    # VOX: HEY, YO, UH, HO, AHH, YEAH, HUH, a scratch
+    shots = [word("h", [("e", 0.6), ("i", 0.4)], 190, 0.3, 81), word(None, [("i", 0.25), ("o", 0.75)], 160, 0.3, 82, gruff=0.3),
+             word(None, [("uh", 1.0)], 140, 0.22, 83, gruff=0.5), word("h", [("o", 1.0)], 175, 0.28, 84),
+             word(None, [("a", 1.0)], 210, 0.33, 85, breath=0.05), word(None, [("i", 0.2), ("ae", 0.8)], 180, 0.33, 86),
+             word("h", [("uh", 1.0)], 150, 0.2, 87, gruff=0.4), scratch(0.3, 88)]
+    shots = [room(x, 0.25, 0.2, 90 + k) for k, x in enumerate(shots)]
+    out["VOX"] = (dusty(one_shots(shots, bpm), 12, 11000, 1.3), 1)
+    return out
+
+
+def bank_888():
+    bpm = 155
+    out = {}
+    n = bar_len(bpm)
+    s16 = n / 16
+    # RUMBLE: the offbeat rumble (a kick's tail through a dark, driven room), ducked on the beat
+    y = np.zeros(n)
+    kk = kick(0.3, 180, 46, 0.03, 0.16, 0.2, 3.5, 101)
+    for b in range(4):
+        place(y, kk, b * 4 * s16, 0.5)
+    wet = room(y, 0.9, 1.0, 102, 600)
+    wet = fft_filter(sat(wet * 3, 2.5), 30, 220)
+    duck = np.ones(n)
+    for b in range(4):
+        a = int(b * 4 * s16)
+        m = int(s16 * 1.6)
+        duck[a:a + m] = np.linspace(0, 1, m) ** 2
+    out["RUMBLE"] = (sat(wet * duck * 2, 1.5), 1)
+    # GABBA: four distorted kicks, the "boing" left in
+    y = np.zeros(n)
+    gk = kick(0.36, 260, 56, 0.025, 0.25, 0.9, 9.0, 103)
+    gk = svf(gk, 900, 3.0) * 0.5 + gk
+    for b in range(4):
+        place(y, sat(gk, 2.0), b * 4 * s16)
+    out["GABBA"] = (crush(sat(y, 1.5), 10), 1)
+    # TRANCE: 8 supersaw stabs, A minor, two bars (a slice = a beat)
+    ch = [[57, 60, 64, 69], [53, 57, 60, 65], [60, 64, 67, 72], [55, 59, 62, 67],
+          [52, 55, 59, 64], [50, 53, 57, 62], [69, 72, 76, 81], [52, 56, 59, 64]]
+    shots = [room(supersaw(c, 0.38, 7000, 0.2, 110 + k), 0.4, 0.3, 120 + k) for k, c in enumerate(ch)]
+    out["TRANCE"] = (one_shots(shots, bpm, 2), 2)
+    # HITS: metal clang, noise crash, laser, riser, HEY (shout), horn, industrial hit, siren chirp
+    d = 0.19
+    nn = int(FS * d)
+    t = t_(nn)
+    r = np.random.default_rng(130)
+    clang = sum(np.sin(2 * np.pi * f * t + 3 * np.sin(2 * np.pi * f * 1.41 * t) * env_exp(nn, 0.04))
+                for f in (233, 377, 611)) * env_ad(nn, 0.001, 0.07) / 3
+    crash = sat(fft_filter(r.standard_normal(nn), 400, 9000) * env_ad(nn, 0.001, 0.08) * 2, 2)
+    laser = np.sin(2 * np.pi * np.cumsum(3000 * np.exp(-t / 0.03) + 80) / FS) * env_ad(nn, 0.001, 0.08)
+    rise = fft_filter(r.standard_normal(nn), 800, 7000) * (t / d) ** 2
+    rise = svf(rise, 300 + 8000 * (t / d) ** 2, 2.0, "bp") * 3
+    hey = sat(word("h", [("e", 0.6), ("i", 0.4)], 230, d, 131, gruff=0.6) * 1.5, 2.5)
+    horn = brass([57, 61, 64], d, 5000)
+    ind = sat(kick(d, 400, 70, 0.01, 0.06, 1.0, 6, 132) + crash * 0.6, 3)
+    siren = np.sign(np.sin(2 * np.pi * np.cumsum(900 + 500 * np.sin(2 * np.pi * 14 * t)) / FS)) * env_ad(nn, 0.005, 0.1) * 0.5
+    shots = [room(x, 0.3, 0.25, 140 + k) for k, x in enumerate([clang, crash, laser, rise, hey, horn, ind, siren])]
+    out["HITS"] = (sat(one_shots(shots, bpm) * 1.3, 1.4), 1)
+    return out
+
+
+def main():
+    if len(sys.argv) < 3 or sys.argv[1] not in ("187", "888"):
+        sys.exit(__doc__)
+    out = Path(sys.argv[2])
+    out.mkdir(parents=True, exist_ok=True)
+    bank = bank_187() if sys.argv[1] == "187" else bank_888()
+    bpm = 96 if sys.argv[1] == "187" else 155
+    lines = [f"# name bars bpm (synthesised by tools/md_gen_samples.py {sys.argv[1]}: no recordings)"]
+    for name, (x, bars) in bank.items():
+        y = norm(decimate(x), 0.92)
+        write_wav(out / f"{name}.wav", y)
+        lines.append(f"{name} {bars} {bpm}")
+        print(f"{name:7s} {bars} bar(s) {len(y)} samples")
+    (out / "bank.txt").write_text("\n".join(lines) + "\n")
+
+
+if __name__ == "__main__":
+    main()
