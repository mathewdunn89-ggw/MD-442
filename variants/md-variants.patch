+    dict(name="HORNS", swing=30,
+         d808={"BD": "x......x..x....."},
+         d909={"SD": "....x.......x...", "CH": "x.x.x.x.x.x.x.x.", "CR": "x..............."},
+         acc909="....x.......x...",
+         brk=dict(slot=2, steps="3-.4-.......3-4-", complex=0, level=95),
+         bass=dict(root=38, row=["0", ".", ".", "0", ".", ".", ".", ".", ".", ".", "a5", ".", ".", ".", ".", "."])),
+    dict(name="SCRATCH", swing=34,
+         d808={"BD": "x......x..x..x.."},
+         d909={"SD": "....x.......x...", "CH": "x.x.x.x.x.x.x.x."},
+         brk=dict(slot=3, steps="........8-8-.8-.", complex=0, level=90),
+         bass=dict(root=38, row=["0", ".", ".", ".", ".", ".", ".", "0", ".", ".", "0", ".", ".", ".", ".", "."])),
+]
+
+# ------------------------------------------------------------------------ MD|888: hard techno, 155 BPM
+# slots: 0 RUMBLE (offbeat rumble), 1 GABBA (four distorted kicks), 2 TRANCE (8 supersaw stabs, 2 bars:
+# a slice a beat: Am F C G Em Dm Am-hi E), 3 HITS (clang, crash, laser, riser, HEY, horn, industrial, siren)
+MD888 = [
+    dict(name="WAREHOUSE", swing=0,
+         d909={"BD": "x...x...x...x...", "CH": "xxxxxxxxxxxxxxxx", "OH": "..x...x...x...x.", "CP": "....x.......x..."},
+         acc909="x...x...x...x...",
+         brk=dict(slot=0, steps="gggggggggggggggg", complex=0, level=90),
+         bass=None),
+    dict(name="GABBA", swing=0,
+         d909={"CH": "..x...x...x...x.", "CP": "....x.......x..."},
+         brk=dict(slot=1, steps="gggggggggggggggg", complex=0, level=110),
+         bass=dict(root=45, row=["a0", ".", "0", ".", "a0", ".", "0", ".", "a0", ".", "0", ".", "a0", ".", "s0", "12"])),
+    dict(name="TRANCE STAB", swing=0,
+         d909={"BD": "x...x...x...x...", "CH": "x.x.x.x.x.x.x.x.", "OH": "..x...x...x...x.", "RD": "x.x.x.x.x.x.x.x."},
+         brk=dict(slot=2, steps="..1-..1-..2-..3-", complex=0, level=95),
+         bass=None),
+    dict(name="INDUSTRY", swing=0,
+         d909={"BD": "x...x...x...x...", "CH": "xxxxxxxxxxxxxxxx", "RS": "...x..x....x..x."},
+         acc909="x...x...x...x...",
+         brk=dict(slot=3, steps="..1-......7-..5-", complex=0, level=90),
+         bass=None),
+    dict(name="ACID 155", swing=0,
+         d909={"BD": "x...x...x...x...", "CH": "..x...x...x...x.", "CP": "....x.......x..."},
+         brk=dict(slot=0, steps="gggggggggggggggg", complex=0, level=70),
+         bass=dict(root=45, row=["a0", "0", "s12", "0", "3", "a0", "s0", "10", "0", "a12", "0", "s7", "a0", "0", "3", "s15"])),
+    dict(name="SCHRANZ", swing=0,
+         d909={"BD": "x...x...x...x...", "CH": "xxxxxxxxxxxxxxxx", "LT": "..x...x...x...x.", "MT": ".x...x...x...x..",
+               "HT": "...x...x...x...x"},
+         acc909="x...x...x...x...",
+         brk=dict(slot=0, steps="gggggggggggggggg", complex=0, level=75),
+         bass=None),
+    dict(name="ROLLING", swing=0,
+         d909={"BD": "x...x...x...x...", "OH": "..x...x...x...x.", "CH": "x.xxx.xxx.xxx.xx"},
+         d808={"RS": ".x..x..x.x..x..x"},
+         brk=dict(slot=0, steps="gggggggggggggggg", complex=0, level=95),
+         bass=None),
+    dict(name="PEAK TIME", swing=0,
+         d909={"BD": "x...x...x...x...", "CP": "....x.......x...", "OH": "..x...x...x...x.", "RD": "x.x.x.x.x.x.x.x.",
+               "CR": "x..............."},
+         acc909="x...x...x...x...",
+         brk=dict(slot=2, steps="1-..1-..6-..7-.4", complex=0, level=100),
+         bass=None),
+]
+
+
+def bits(row):
+    assert len(row) == 16, row
+    return sum(1 << i for i, c in enumerate(row) if c not in ".")
+
+
+def emit(var, pats):
+    out = [f"static const mdv_preset_t MDV_PRESETS_{var}[] = {{"]
+    for p in pats:
+        d9 = [bits(p.get("d909", {}).get(t, "." * 16)) for t in T909]
+        d8 = [bits(p.get("d808", {}).get(t, "." * 16)) for t in T808]
+        a9, a8 = bits(p.get("acc909", "." * 16)), bits(p.get("acc808", "." * 16))
+        b = p["brk"]
+        steps = b["steps"]
+        bsteps = sum(1 << i for i, c in enumerate(steps) if c != ".")
+        slices = [int(c) if c.isdigit() else 0 for c in steps]
+        bass = p.get("bass")
+        if bass:
+            notes, flags = [], []
+            for c in bass["row"]:
+                if c == ".":
+                    notes.append(0)
+                    flags.append(0)
+                    continue
+                kind = c[0] if c[0] in "asA" else "n"
+                off = int(c[1:] if kind != "n" else c)
+                notes.append(off)
+                flags.append(1 | (4 if kind in "aA" else 0) | (8 if kind in "sA" else 0))
+            root = bass["root"]
+        else:
+            notes, flags, root = [0] * 16, [0] * 16, 0
+        out.append(f"    {{ /* {p['name']} */ {p['swing']}, {{{', '.join(map(str, d9))}}}, {a9},")
+        out.append(f"      {{{', '.join(map(str, d8))}}}, {a8},")
+        out.append(f"      {b['slot']}, {b.get('complex', 0)}, {b.get('level', 100)}, {bsteps}, {{{', '.join(map(str, slices))}}},")
+        out.append(f"      {root}, {{{', '.join(map(str, notes))}}}, {{{', '.join(map(str, flags))}}}}},")
+    out.append("};")
+    return out
+
+
+def main():
+    h = ["/* SPDX-License-Identifier: GPL-3.0-only */",
+         "/* Generated by tools/md_gen_presets.py -- edit the grids there. MD|187 and MD|888's factory patterns. */",
+         "#pragma once", "#include <stdint.h>", "",
+         "typedef struct {",
+         "    uint8_t swing;",
+         "    uint16_t d909[11], acc909;",
+         "    uint16_t d808[11], acc808;",
+         "    uint8_t brk_slot, brk_complex, brk_level;",
+         "    uint16_t brk_steps;",
+         "    uint8_t brk_slice[16];",
+         "    uint8_t root;                          /* 0: no 303 line */",
+         "    int8_t notes[16];",
+         "    uint8_t flags[16];                     /* 1 note, 4 accent, 8 slide */",
+         "} mdv_preset_t;", ""]
+    h += emit(187, MD187) + [""] + emit(888, MD888) + [""]
+    open(sys.argv[1], "w").write("\n".join(h))
+    print(f"{len(MD187)} + {len(MD888)} patterns")
+
+
+if __name__ == "__main__":
+    main()
