+         d909={"SD": "....x.......x...", "CP": "............x...", "CH": "x.xxx.x.x.xxx.x."},
+         brk=dict(slot=3, steps="..1-......2-..8-", complex=0, level=90),
+         bass=dict(root=38, row=["0", ".", ".", ".", ".", ".", "0", ".", ".", ".", "3", ".", ".", ".", ".", "."])),
+    dict(name="LAID BACK", swing=48,
+         d808={"BD": "x.......x.x....."},
+         d909={"RS": "....x.......x...", "CH": "x.x.x.x.x.x.x.x.", "OH": "......x........."},
+         brk=dict(slot=1, steps="......7-......7-", complex=0, level=80),
+         bass=dict(root=36, row=["0", ".", ".", ".", ".", ".", ".", ".", "0", ".", "s7", "5", ".", ".", ".", "."])),
+    dict(name="CHOP SHOP", swing=28,
