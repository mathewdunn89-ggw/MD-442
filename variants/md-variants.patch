+         bass=dict(root=38, row=["0", ".", ".", ".", ".", ".", ".", ".", ".", ".", "0", ".", ".", "-2", ".", "."])),
+    dict(name="STAB CITY", swing=30,
+         d808={"BD": "x......x.x......"},
+         d909={"SD": "....x.......x...", "CH": "x.x.x.x.x.x.x.x.", "RS": ".......x......x."},
+         acc909="....x.......x...",
