+def bank_888():
+    bpm = 155
+    out = {}
+    n = bar_len(bpm)
+    s16 = n / 16
+    # RUMBLE: the offbeat rumble (a kick's tail through a dark, driven room), ducked on the beat
+    y = np.zeros(n)
+    kk = kick(0.3, 180, 46, 0.03, 0.16, 0.2, 3.5, 101)
+    for b in range(4):
+        place(y, kk, b * 4 * s16, 0.5)
+    wet = room(y, 0.9, 1.0, 102, 600)
+    wet = fft_filter(sat(wet * 3, 2.5), 30, 220)
+    duck = np.ones(n)
+    for b in range(4):
+        a = int(b * 4 * s16)
+        m = int(s16 * 1.6)
+        duck[a:a + m] = np.linspace(0, 1, m) ** 2
+    out["RUMBLE"] = (sat(wet * duck * 2, 1.5), 1)
+    # GABBA: four distorted kicks, the "boing" left in
+    y = np.zeros(n)
+    gk = kick(0.36, 260, 56, 0.025, 0.25, 0.9, 9.0, 103)
+    gk = svf(gk, 900, 3.0) * 0.5 + gk
+    for b in range(4):
+        place(y, sat(gk, 2.0), b * 4 * s16)
+    out["GABBA"] = (crush(sat(y, 1.5), 10), 1)
+    # TRANCE: 8 supersaw stabs, A minor, two bars (a slice = a beat)
+    ch = [[57, 60, 64, 69], [53, 57, 60, 65], [60, 64, 67, 72], [55, 59, 62, 67],
+          [52, 55, 59, 64], [50, 53, 57, 62], [69, 72, 76, 81], [52, 56, 59, 64]]
+    shots = [room(supersaw(c, 0.38, 7000, 0.2, 110 + k), 0.4, 0.3, 120 + k) for k, c in enumerate(ch)]
+    out["TRANCE"] = (one_shots(shots, bpm, 2), 2)
+    # HITS: metal clang, noise crash, laser, riser, HEY (shout), horn, industrial hit, siren chirp
+    d = 0.19
+    nn = int(FS * d)
+    t = t_(nn)
+    r = np.random.default_rng(130)
+    clang = sum(np.sin(2 * np.pi * f * t + 3 * np.sin(2 * np.pi * f * 1.41 * t) * env_exp(nn, 0.04))
+                for f in (233, 377, 611)) * env_ad(nn, 0.001, 0.07) / 3
+    crash = sat(fft_filter(r.standard_normal(nn), 400, 9000) * env_ad(nn, 0.001, 0.08) * 2, 2)
+    laser = np.sin(2 * np.pi * np.cumsum(3000 * np.exp(-t / 0.03) + 80) / FS) * env_ad(nn, 0.001, 0.08)
+    rise = fft_filter(r.standard_normal(nn), 800, 7000) * (t / d) ** 2
+    rise = svf(rise, 300 + 8000 * (t / d) ** 2, 2.0, "bp") * 3
+    hey = sat(word("h", [("e", 0.6), ("i", 0.4)], 230, d, 131, gruff=0.6) * 1.5, 2.5)
+    horn = brass([57, 61, 64], d, 5000)
+    ind = sat(kick(d, 400, 70, 0.01, 0.06, 1.0, 6, 132) + crash * 0.6, 3)
+    siren = np.sign(np.sin(2 * np.pi * np.cumsum(900 + 500 * np.sin(2 * np.pi * 14 * t)) / FS)) * env_ad(nn, 0.005, 0.1) * 0.5
+    shots = [room(x, 0.3, 0.25, 140 + k) for k, x in enumerate([clang, crash, laser, rise, hey, horn, ind, siren])]
+    out["HITS"] = (sat(one_shots(shots, bpm) * 1.3, 1.4), 1)
+    return out
+
+
+def main():
+    if len(sys.argv) < 3 or sys.argv[1] not in ("187", "888"):
+        sys.exit(__doc__)
+    out = Path(sys.argv[2])
+    out.mkdir(parents=True, exist_ok=True)
+    bank = bank_187() if sys.argv[1] == "187" else bank_888()
+    bpm = 96 if sys.argv[1] == "187" else 155
+    lines = [f"# name bars bpm (synthesised by tools/md_gen_samples.py {sys.argv[1]}: no recordings)"]
+    for name, (x, bars) in bank.items():
+        y = norm(decimate(x), 0.92)
+        write_wav(out / f"{name}.wav", y)
+        lines.append(f"{name} {bars} {bpm}")
+        print(f"{name:7s} {bars} bar(s) {len(y)} samples")
+    (out / "bank.txt").write_text("\n".join(lines) + "\n")
+
+
+if __name__ == "__main__":
+    main()
