+/* ------------------------------------------------------------------- solo --- */
+static uint8_t md_solo = 0xFF;                         /* the soloed pad, 0xFF = none */
+static uint32_t md_solo_m, md_solo_v;                  /* the mutes before it */
+static void md_solo_pad(int w)
+{
+    uint32_t all = 0, i;
+    for (i = 0; i < NPARTS; i++)
+        all |= MUTE_MASK[i];
+    if (md_solo == w) {                                 /* again: as it was */
+        seq.mute = md_solo_m;
+        seq.vmute = md_solo_v;
+        md_solo = 0xFF;
+        say("SOLO OFF", 0);
+        return;
+    }
+    if (md_solo == 0xFF) {
+        md_solo_m = seq.mute;
+        md_solo_v = seq.vmute;
+    }
+    md_solo = (uint8_t)w;
+    if (w < 11) {
+        int km = md_mute_kit(), v = km ? MD_ORD808[w] : MD_ORD909[w];
+        seq.mute = all & ~MUTE_MASK[km];
+        seq.vmute = (md_solo_v & ~MUTE_MASK[km]) | (MUTE_MASK[km] & ~(1u << (km * NDRUM + v)));
+        say("SOLO ", engine_voice_name(km ? T_808 : T_909, v));
+    } else {
+        seq.mute = all & ~MUTE_MASK[w - 11];
+        say("SOLO ", PART_N[w - 11]);
+    }
+}
