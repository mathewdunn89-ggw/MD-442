+}
+
+/* MD|187 (hip-hop) and MD|888 (hard techno): their own factory patterns 1-8 (md_variant_presets.h) */
+#if defined(MD_VARIANT) && MD_VARIANT != 442
+#include "md_variant_presets.h"
+#if MD_VARIANT == 187
+#define MDV_PRESETS MDV_PRESETS_187
+#else
+#define MDV_PRESETS MDV_PRESETS_888
+#endif
+#define MDV_NPRESETS ((int)(sizeof MDV_PRESETS / sizeof MDV_PRESETS[0]))
+
+static void mdv_load_preset(pattern_t *p, const mdv_preset_t *m)
+{
+    int r, i;
+    for (r = 0; r < 11; r++)
+        for (i = 0; i < 16; i++) {
+            if ((m->d909[r] >> i) & 1u)
+                sm_set(p->drum[0].hit[r], i);
+            if ((m->d808[r] >> i) & 1u)
+                sm_set(p->drum[1].hit[r], i);
+        }
+    for (i = 0; i < 16; i++) {
+        if ((m->acc909 >> i) & 1u)
+            sm_set(p->drum[0].accent, i);
+        if ((m->acc808 >> i) & 1u)
+            sm_set(p->drum[1].accent, i);
+    }
+    p->drum[0].len = p->drum[1].len = 16;
+    p->brk.steps = m->brk_steps;
+    p->brk.slot_a = p->brk.slot_b = m->brk_slot;
+    p->brk.set[BRK_COMPLEX] = m->brk_complex;
+#if MD_VARIANT == 888
+    if (m->brk_slot == 2)
+        p->brk.set[BRK_ALEN] = 3;                        /* TRANCE is two bars: a slice a beat */
+#endif
+    for (i = 0; i < 16; i++)
+        p->brk.slice[i] = m->brk_slice[i];
+    if (m->root) {
+        bpart_t *b = &p->bass[0];
+        b->len = 16;
+        for (i = 0; i < 16; i++) {
+            b->step[i].note = (uint8_t)(m->root + m->notes[i]);
+            b->step[i].flags = m->flags[i] ? (uint8_t)(G_NOTE | (m->flags[i] & (BS_ACCENT | BS_SLIDE))) : G_REST;
+        }
+    }
+    p->swing = m->swing;
 }
+#endif
diff --git a/firmware/src/app/md_perform.c b/firmware/src/app/md_perform.c
new file mode 100644
index 0000000..57aa7d0
--- /dev/null
+++ b/firmware/src/app/md_perform.c
@@ -0,0 +1,971 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* MD PERFORM: the SMK-37's controls laid out for making music from the keyboard alone (MD442, MD187 and
+ * MD888 share it). Included by main_fm1.c after the UI (ui.c) in this unity build.
+ *
+ *   KEYS      the 27 middle keys always play the instrument on screen (never the steps): DRUMS 1 / 2 the kit,
+ *             BASS and CHORDS notes (OCTAVE- / + the octave), BREAKS the slices; REC while playing records them
+ *   PADS      the instrument's 16 steps (tap on / off); BASS / CHORDS: a pad held + a key = that step's note
+ *   < / >     the instrument: DRUMS 1, DRUMS 2, BASS, CHORDS, BREAKS
+ *   FX        the faders: lit = REVERB, DELAY, DRIVE, FILTER; off = the volumes (DRUMS 1 / BREAKS by FADER BANK,
+ *             DRUMS 2, BASS, CHORDS)
+ *   SOUND     KNOB BANK held: K2 FILTER (left low-pass, right high-pass), K3 RESONANCE, K4 DECAY (BASS / CHORDS:
+ *             CUTOFF, RESO, ENV MOD); else the knobs are X0X's own (stock)
+ *   SCENES    PATCH + < / >: the pattern before / after, at the bar; PATCH + a pad: that pattern
+ *   MUTE      KNOB BANK tap: mute pads (1-11 tracks, 12-16 parts), hold: while held; PATCH + a pad: solo;
+ *             PATCH + KNOB BANK: unmute all
+ *   LEFT END  C3 REPEAT 1/2, C#3 1/4, D3 1/8, D#3 1/16 (hold), E3 FILL (a roll, faster and louder)
+ *   RIGHT END G#5 ECHO THROW, A5 KILL LOW, A#5 WASH, B5 RISER, C6 DROP; KILL LOW, RISER and DROP come back
+ *             on the next one. PATCH + ECHO / WASH: every part
+ *   mod wheel on a drum or the BREAK: a high-pass riser on it; on BASS / CHORDS their cutoff
+ * In a list, a question or GLO, K2..K4 and < / > are X0X's own again. */
+
+#include "../dsp/drum808.h"
+#include "../dsp/md_filter.h"
+
+enum { MDI_N = 25, MDI_303A = 22, MDI_303B = 23, MDI_BRK = 24 };
+static const uint8_t MD_ORD909[11] = {DR_BD, DR_SD, DR_CP, DR_CH, DR_OH, DR_LT, DR_MT, DR_HT, DR_RS, DR_CR, DR_RD};
+static const uint8_t MD_ORD808[11] = {D8_BD, D8_SD, D8_CP, D8_CH, D8_OH, D8_LT, D8_MT, D8_HT, D8_RS, D8_CY, D8_CB};   /* the 909's pad places */
+static int8_t md_pos[MDF_N];          /* each instrument's filter: -63..63, 0 off (not saved: a set starts clean) */
+static uint8_t md_res[MDF_N];
+static uint8_t md_wheel;              /* the mod wheel, 0..127 (smk_wheels) */
+
+static int md_inst(void)                               /* the selected instrument, 0..24 */
+{
+    int k;
+    if (ui.part == PART_303A)
+        return MDI_303A;
+    if (ui.part == PART_303B)
+        return MDI_303B;
+    if (ui.part == PART_BRK)
+        return MDI_BRK;
+    for (k = 0; k < 11; k++)
+        if ((ui.part == PART_909 ? MD_ORD909[k] : MD_ORD808[k]) == ui.sel[ui.part])
+            return ui.part * 11 + k;
+    return ui.part * 11;
+}
+
+static int md_inst_flt(int i)                          /* its filter (md_flt), -1: a 303 (its own filter) */
+{
+    if (i < 11)
+        return MDF_909 + MD_ORD909[i];
+    if (i < 22)
+        return MDF_808 + MD_ORD808[i - 11];
+    return i == MDI_BRK ? MDF_BRK : -1;
+}
+
+static void md_name(char *t, int i)
+{
+    char *q;
+    if (i < 22) {
+        q = put_s(t, i < 11 ? "DR1 " : "DR2 ");
+        put_s(q, engine_voice_name(i < 11 ? T_909 : T_808, i < 11 ? MD_ORD909[i] : MD_ORD808[i - 11]));
+    } else
+        put_s(t, PART_N[i - 20]);
+}
+
+static void md_piano_off(void);
+static void md_select(int i)
+{
+    char t[28];
+    md_piano_off();
+    i = (i % MDI_N + MDI_N) % MDI_N;
+    if (i < 22) {
+        int km = i < 11 ? PART_909 : PART_808;
+        ui.part = (uint8_t)km;
+        ui.sel[km] = i < 11 ? MD_ORD909[i] : MD_ORD808[i - 11];
+        if (!seq.playing || proj.set.keysound)
+            engine_drum(km, ui.sel[km], 0.75f);
+    } else
+        ui.part = (uint8_t)(i - 20);
+    if (ui.view == V_GEN && !is_303())
+        set_view(V_PART);
+    else if (ui.view == V_HOME || ui.view == V_SONG || ui.view == V_FX || ui.view == V_PERF)
+        set_view(V_PART);
+    ui.outline_ok = 0;
+    if (ui.view == V_MIX)
+        ui.mixsel = ui.part;
+    build_pages();
+    md_name(t, i);
+    say(t, 0);
+}
+
+static void md_flt_apply(int f)
+{
+    int p = md_pos[f];
+    if (md_wheel && f >= 0) {                             /* the riser: high-pass up from where it is */
+        int w = md_wheel * 63 / 127;
+        p = p > w ? p : w;
+    }
+    md_flt_set(&md_flt[f], p, md_res[f]);
+}
+
+static int md_decay_param(int target, int voice)       /* a track's "tone" knob: its decay (or tail, or tune) */
+{
+    static const char *const PREF[3] = {"Decay", "Tail", "Tune"};
+    int k, i, n = engine_nparams(target, voice);
+    for (k = 0; k < 3; k++)
+        for (i = 0; i < n; i++) {
+            const x0x_param_t *d = engine_param(target, voice, i);
+            if (d && strcmp_s(d->name, PREF[k]) == 0)
+                return i;
+        }
+    return 0;
+}
+
+static void md_say_val(const char *who, const char *what, int v, int lohi)
+{
+    char t[28], *q = put_s(put_s(put_s(t, who), " "), what);
+    q = put_s(q, " ");
+    if (lohi) {
+        if (v == 0)
+            put_s(q, "OFF");
+        else
+            put_i(put_s(q, v < 0 ? "LP " : "HP "), (v < 0 ? -v : v) * 100 / 63);
+    } else
+        put_i(q, v);
+    say(t, 0);
+}
+
+static uint32_t md_len(const char *s)
+{
+    uint32_t n = 0;
+    while (s[n])
+        n++;
+    return n;
+}
+
+static void md_pref_turn(pref_t r, int e, int role, const char *who)
+{
+    const x0x_param_t *d = pref_desc(r);
+    char num[16], unit[8], t[28], *q;
+    int v;
+    if (!d)
+        return;
+    v = pref_get(r) + accel(role, e, d->max);
+    v = v < 0 ? 0 : v > d->max ? d->max : v;
+    pref_set(r, v);
+    motion_touch(r);
+    ui.act_t = plat_ms();
+    pref_value(r, num, unit);
+    q = put_s(put_s(put_s(put_s(t, who), " "), d->name), " ");
+    if (md_len(num) + md_len(unit) + (uint32_t)(q - t) < 27u)
+        put_s(put_s(q, num), unit);
+    say(t, 0);
+}
+
+/* K2..K4: the selected instrument's filter, resonance, tone */
+static void md_knob(int which, int e)
+{
+    int i = md_inst(), f = md_inst_flt(i);
+    char who[16];
+    md_name(who, i);
+    if (i == MDI_303A || i == MDI_303B) {
+        static const uint8_t P3[3] = {BASS303_CUTOFF, BASS303_RESO, BASS303_ENVMOD};
+        md_pref_turn(PR(R_ENG, T_303, i - MDI_303A, P3[which]), e, EN_SELECT + which, who);
+        return;
+    }
+    if (which == 0) {                                     /* FILTER: one detent each, it rests at the middle */
+        int p = md_pos[f], s = accel(EN_SELECT, e, 126), n = p + s;
+        if ((p < 0 && n > 0) || (p > 0 && n < 0))
+            n = 0;
+        n = n < -63 ? -63 : n > 63 ? 63 : n;
+        md_pos[f] = (int8_t)n;
+        md_flt_apply(f);
+        md_say_val(who, "FILTER", n, 1);
+    } else if (which == 1) {
+        int r = md_res[f] + accel(EN_ALGO, e, 127);
+        md_res[f] = (uint8_t)(r < 0 ? 0 : r > 127 ? 127 : r);
+        md_flt_apply(f);
+        md_say_val(who, "RESO", md_res[f] * 100 / 127, 0);
+    } else if (i == MDI_BRK) {
+        md_pref_turn(PR(R_ENG, T_BRK, 0, BRK_PITCH), e, EN_PRESET, who);
+    } else {
+        int t = i < 11 ? T_909 : T_808, v = i < 11 ? MD_ORD909[i] : MD_ORD808[i - 11];
+        md_pref_turn(PR(R_ENG, t, v, md_decay_param(t, v)), e, EN_PRESET, who);
+    }
+}
+
+/* ------------------------------------------------------------------ mutes --- */
+static uint8_t md_mute_on, md_mute_used, md_kb_held;
+static uint32_t md_kb_t0;
+static int md_mute_kit(void) { return ui.part == PART_808 ? 1 : 0; }
+
+static void md_mute_pad(int w)                         /* pad w (0 = pad 1, top left) */
+{
+    ui.act_t = plat_ms();
+    if (w < 11) {
+        int km = md_mute_kit();
+        mute_track(km, km ? MD_ORD808[w] : MD_ORD909[w]);
+    } else if (w < 16)
+        mute_part(w - 11);
+}
+
+static void md_mute_leds(void)
+{
+    uint32_t w;
+    int km = md_mute_kit();
+    uint16_t kc = PART_COL[km];
+    for (w = 0; w < SMK_NPAD; w++) {
+        uint16_t c;
+        int muted, sh;
+        if (w < 11) {
+            muted = track_muted(km, km ? MD_ORD808[w] : MD_ORD909[w]) || part_muted(km);
+            c = kc;
+        } else if (w < 16) {
+            muted = part_muted((int)w - 11);
+            c = PART_COL[w - 11];
+        } else
+            continue;
+        sh = muted ? 4 : 1;
+        if (muted)
+            c = RGB(255, 40, 30);                        /* muted: a dim red, so the playing ones stand out */
+        padled_set(w, (uint8_t)(((uint32_t)(c >> 11) * 255u / 31u) >> sh), (uint8_t)(((uint32_t)((c >> 5) & 63u) * 255u / 63u) >> sh),
+                   (uint8_t)(((uint32_t)(c & 31u) * 255u / 31u) >> sh));
+    }
+    padled_flush();
+}
+
+/* ------------------------------------------------------------------- solo --- */
+static uint8_t md_solo = 0xFF;                         /* the soloed pad, 0xFF = none */
+static uint32_t md_solo_m, md_solo_v;                  /* the mutes before it */
+static void md_solo_pad(int w)
+{
+    uint32_t all = 0, i;
+    for (i = 0; i < NPARTS; i++)
+        all |= MUTE_MASK[i];
+    if (md_solo == w) {                                 /* again: as it was */
+        seq.mute = md_solo_m;
+        seq.vmute = md_solo_v;
+        md_solo = 0xFF;
+        say("SOLO OFF", 0);
+        return;
+    }
+    if (md_solo == 0xFF) {
+        md_solo_m = seq.mute;
+        md_solo_v = seq.vmute;
+    }
+    md_solo = (uint8_t)w;
+    if (w < 11) {
+        int km = md_mute_kit(), v = km ? MD_ORD808[w] : MD_ORD909[w];
+        seq.mute = all & ~MUTE_MASK[km];
+        seq.vmute = (md_solo_v & ~MUTE_MASK[km]) | (MUTE_MASK[km] & ~(1u << (km * NDRUM + v)));
+        say("SOLO ", engine_voice_name(km ? T_808 : T_909, v));
+    } else {
+        seq.mute = all & ~MUTE_MASK[w - 11];
+        say("SOLO ", PART_N[w - 11]);
+    }
+}
+
+/* --------------------------------------------------------------- drum pads --- */
+static uint8_t md_drums;                               /* PATCH + FADER BANK: the pads play the kit */
+static uint16_t md_drum_lit;                           /* pads held */
+static void md_drum_hit(int km, int v, float f)
+{
+    engine_drum(km, v, f);
+    ui.act_t = plat_ms();
+    if (km == ui.part && ui.sel[km] != v) {             /* the pad played is the one the knobs shape */
+        ui.sel[km] = (uint8_t)v;
+        build_pages();
+    }
+    if (ui.rec && seq.playing) {                       /* to the nearest step: a late half goes to the next */
+        int t = TRK_DRUM + km, s = eng_step[t];
+        uint32_t L = seq_step_q8(&seq, pat_of(km)->drum[km].rate & 3);
+        dpart_t *d = &pat_of(km)->drum[km];
+        if (seq.t[t].to_next != 0xFFFFFFFFu && seq.t[t].to_next < L / 2u) {
+            uint32_t l = fm1__lock();
+            s = seq_next_step(&seq, t, s);
+            seq.skip1 |= 1u << (km * NDRUM + v);       /* heard now: the step does not play it again */
+            fm1__unlock(l);
+        }
+        sm_set(d->hit[v], s);
+        if (f >= 0.9f)
+            sm_set(d->accent, s);
+        mark_dirty();
+    }
+}
+
+static void md_drum_pad(int w, int vel)                /* pads 1-11: the kit on screen, 12-16: the other's BD SD CP CH OH */
+{
+    int km = md_mute_kit(), v;
+    float f = (float)(vel < 1 ? 1 : vel) / 127.0f;
+    if (w >= 11)
+        km ^= 1;
+    v = km ? MD_ORD808[w < 11 ? w : w - 11] : MD_ORD909[w < 11 ? w : w - 11];
+    md_drum_hit(km, v, f);
+}
+
+/* -------------------------------------------- a held pad + a fader: its volume --- */
+/* Hold a pad and move any fader: the volume of that pad's instrument, whatever FX and FADER BANK say. The pads
+ * are the instruments as in the mutes: 1-11 the drums of the kit on screen (BD SD CP CH OH LT MT HT RS CR RD),
+ * 12-16 DRUMS 1, DRUMS 2, BASS, CHORDS, BREAKS (pads that play the kit: 12-16 the other kit's BD SD CP CH OH).
+ * What the press did to a step or a mute is put back, and the release leaves it alone. PATCH or BT held, or
+ * the pattern and song screens: the pad is a pattern, the faders stay themselves. */
+static uint8_t md_vol_w = 0xFF, md_vol_eng, md_vol_ref[4];
+static void md_vol_frame(void)                         /* each frame, before the faders are read */
+{
+    uint32_t pads = fm1_in.pnotes, w, i;
+    for (w = 0; w < SMK_NPAD; w++)
+        if ((pads >> SMK_WHITE_NOTE[w]) & 1u)
+            break;
+    if (w >= SMK_NPAD)
+        w = 0xFF;
+    if (w != md_vol_w) {                                /* another pad (or none): the faders' places now are the start */
+        md_vol_w = (uint8_t)w;
+        md_vol_eng = 0;
+        for (i = 0; i < 4u; i++)
+            md_vol_ref[i] = fm1_in.fader[i];
+    }
+}
+
+static void md_vol_putback(int w)                      /* the press that started the hold: undone */
+{
+    if (md_drums)
+        return;
+    if (md_mute_on) {
+        md_mute_pad(w);                                 /* (the press toggled it: again) */
+        return;
+    }
+    if (is_drum() && ui.hold_step >= 0) {
+        if (ui.hold_created) {
+            sm_flip(cur_pat()->drum[ui.part].hit[ui.sel[ui.part]], ui.hold_step);
+            mark_dirty();
+        }
+        ui.hold_created = 1;                            /* (the release: no tap-off) */
+    } else if (is_303() && ui.held_step >= 0) {
+        if (ui.step_created) {
+            cur_pat()->bass[bidx()].step[ui.held_step].flags = G_REST;
+            mark_dirty();
+        }
+        ui.step_created = 1;
+    } else if (!is_drum() && !is_303() && ui.brk_held >= 0) {
+        if (ui.hold_created) {
+            cur_pat()->brk.steps &= ~(1u << ui.brk_held);
+            mark_dirty();
+        }
+        ui.hold_created = 1;
+    }
+}
+
+static int md_pad_vol(uint32_t i, uint32_t v)          /* fader i moved to v: 1 = a held pad took it */
+{
+    int w = md_vol_w, km, dv = -1, d0;
+    pref_t r;
+    const x0x_param_t *d;
+    char t[28], num[16], unit[8], *q;
+    uint32_t n = 0, u = 0;
+    if (w == 0xFF || i >= 4u || (ui.btn & (1u << B_HOME | 1u << B_SAVE)) || ui.overlay == O_ASK)
+        return 0;
+    if (!md_mute_on && !md_drums && (ui.view == V_HOME || ui.view == V_SONG))   /* the pads are patterns there */
+        return 0;
+    if (!md_vol_eng) {
+        d0 = (int)v - (int)md_vol_ref[i];
+        if (d0 > -3 && d0 < 3)                          /* (a fader brushed: not a move) */
+            return 1;
+        md_vol_eng = 1;
+        md_vol_putback(w);
+    }
+    km = md_mute_kit();
+    if (w < 11)
+        dv = w;
+    else if (md_drums && !md_mute_on) {
+        km ^= 1;
+        dv = w - 11;
+    }
+    if (dv >= 0) {
+        int tv = km ? MD_ORD808[dv] : MD_ORD909[dv];
+        r = find_ref(km ? T_808 : T_909, tv, "Level");
+        md_name(t, km * 11 + dv);
+    } else {
+        r = PR(R_ENG, T_MIX, w - 11, MX_LEVEL);
+        put_s(t, PART_N[w - 11]);
+    }
+    d = pref_desc(r);
+    if (!d)
+        return 1;
+    pref_set(r, (int)((v * d->max + 63u) / 127u));
+    motion_touch(r);
+    ui.act_t = plat_ms();
+    pref_value(r, num, unit);
+    for (q = t; *q; q++)
+        ;
+    q = put_s(q, " VOL ");
+    while (n < 16u && num[n])
+        n++;
+    while (u < 8u && unit[u])
+        u++;
+    if ((uint32_t)(q - t) + n < sizeof t) {             /* the name (<= 7) + " VOL " + the number: fits say() */
+        q = put_s(q, num);
+        if ((uint32_t)(q - t) + u < sizeof t)
+            put_s(q, unit);
+    }
+    say(t, 0);
+    return 1;
+}
+
+/* ---------------------------------------------------------------- the piano --- */
+/* The keybed's 27 middle keys (F3..G5) always play the instrument on screen, never the steps (the pads are
+ * those): DRUMS 1 / 2 the kit (BD SD CP CH OH LT MT HT RS CR RD from F3 up, again from E4, with velocity),
+ * BASS and CHORDS notes (OCTAVE- / + the octave; CHORDS sounds an octave up; the newest key held wins, BASS
+ * slides between held keys), BREAKS the slices 1-8. REC while playing: what is played goes into the pattern
+ * at the nearest step. A pad held on BASS / CHORDS + a key: that step's note. A new pad step takes the note
+ * last played. */
+static uint32_t md_prev_keys;
+static uint8_t md_stack[NBASS][8], md_nstack[NBASS];   /* the keys held on each 303, oldest first */
+
+static int md_key_note(int b, int k)
+{
+    int n = 41 + k + 12 * ui.oct + (b ? 12 : 0);
+    return n < 0 ? 0 : n > 127 ? 127 : n;
+}
+
+static void md_bass_rec(int b, int n, int acc)
+{
+    int t = TRK_BASS0 + b, s = eng_step[t];
+    bpart_t *bp = &pat_of(PART_303A + b)->bass[b];
+    uint32_t L = seq_step_q8(&seq, bp->rate & 3);
+    if (seq.t[t].to_next != 0xFFFFFFFFu && seq.t[t].to_next < L / 2u) {   /* late half: the next step */
+        uint32_t l = fm1__lock();
+        s = seq_next_step(&seq, t, s);
+        fm1__unlock(l);
+    }
+    if (s < 0 || s >= NSTEPS)
+        return;
+    bp->step[s].note = (uint8_t)clamp(n - (bp->transpose - 24), 0, 127);
+    bp->step[s].flags = (uint8_t)(G_NOTE | (acc ? BS_ACCENT : 0));
+    mark_dirty();
+}
+
+static void md_bass_key(int b, int k, int down, int vel)
+{
+    int n = md_key_note(b, k), i, j;
+    if (down) {
+        int acc = vel >= 112 || (ui.btn & (1u << B_ENV)) != 0;
+        if (ui.btn & (1u << B_ENV))
+            ui.btn_used |= 1u << B_ENV;
+        if (md_nstack[b] == sizeof md_stack[b])        /* (full: the oldest goes) */
+            for (md_nstack[b]--, i = 0; i < md_nstack[b]; i++)
+                md_stack[b][i] = md_stack[b][i + 1];
+        engine_bass_on(b, n, acc, b == 0 && md_nstack[b] > 0);   /* BASS slides legato; CHORDS restrikes */
+        md_stack[b][md_nstack[b]++] = (uint8_t)n;
+        md_last_note[b] = (uint8_t)n;
+        if (ui.part == PART_303A + b && steps_view() && ui.held_step >= 0) {   /* a pad held: its note */
+            bpart_t *bp = &cur_pat()->bass[b];
+            bp->step[ui.held_step].note = (uint8_t)clamp(n - (bp->transpose - 24), 0, 127);
+            ui.step_edited = 1;                          /* (its release keeps the step) */
+            mark_dirty();
+        } else if (ui.rec && seq.playing)
+            md_bass_rec(b, n, acc);
+        return;
+    }
+    for (i = j = 0; i < md_nstack[b]; i++)              /* released: off the stack */
+        if (md_stack[b][i] != n)
+            md_stack[b][j++] = md_stack[b][i];
+    if (j == md_nstack[b])
+        return;
+    md_nstack[b] = (uint8_t)j;
+    if (!j)
+        engine_bass_off(b);
+    else if (b == 0)
+        engine_bass_on(b, md_stack[b][j - 1], 0, 1);     /* BASS: back to the key still held */
+}
+
+static void md_piano_off(void)                          /* another instrument: nothing left ringing */
+{
+    int b;
+    for (b = 0; b < NBASS; b++)
+        if (md_nstack[b]) {
+            md_nstack[b] = 0;
+            engine_bass_off(b);
+        }
+}
+
+static void md_piano(void)
+{
+    uint32_t keys = fm1_in.knotes & ((1u << NKEYS) - 1u), ch = keys ^ md_prev_keys, k;
+    int block = ui.overlay == O_ASK || ui.view == V_PERF || perf_testing();
+    static int8_t part = -1;
+    if (ui.part != part) {                               /* another instrument by any way (K3 too): no note left held */
+        if (part >= 0)
+            md_piano_off();
+        part = (int8_t)ui.part;
+    }
+    md_prev_keys = keys;
+    for (k = 0; ch && k < NKEYS; k++) {
+        int down, vel;
+        if (!((ch >> k) & 1u))
+            continue;
+        down = (int)((keys >> k) & 1u);
+        vel = fm1_in.key_vel[SMK_KEY_F3 + k];
+        if (block && down)
+            continue;
+        if (is_303())
+            md_bass_key(bidx(), (int)k, down, vel);
+        else if (is_drum()) {
+            if (down) {
+                int km = ui.part, v = km ? MD_ORD808[k % 11] : MD_ORD909[k % 11];
+                if (ui.btn & (1u << B_ENV))
+                    ui.btn_used |= 1u << B_ENV;
+                md_drum_hit(km, v, (ui.btn & (1u << B_ENV)) ? 1.0f : (float)(vel < 1 ? 1 : vel) / 127.0f);
+            }
+        } else
+            engine_brk_live((int)(k % 8), down);
+        if (down)
+            ui.act_t = plat_ms();
+    }
+}
+
+/* < / >: the instrument before / after (DRUMS 1, DRUMS 2, BASS, CHORDS, BREAKS); in a list, a question, GLO,
+ * PERF or the song they are SELECT again (main_fm1.c smk_arrows) */
+static int md_arrows_take(void)
+{
+    return ui.overlay == O_NONE && ui.view != V_GLO && ui.view != V_PERF && ui.view != V_SONG &&
+           !((plat_buttons() >> B_HOME) & 1u);
+}
+static void md_part(int p)
+{
+    p = (p % NPARTS + NPARTS) % NPARTS;
+    md_piano_off();
+    ui.part = (uint8_t)p;
+    if (ui.view == V_GEN && !is_303())
+        set_view(V_PART);
+    else if (ui.view == V_HOME || ui.view == V_FX)
+        set_view(V_PART);
+    ui.outline_ok = 0;
+    if (ui.view == V_MIX)
+        ui.mixsel = ui.part;
+    build_pages();
+    say(PART_N[p], is_drum() ? ": KEYS PLAY THE KIT" : is_303() ? ": KEYS PLAY NOTES" : ": KEYS PLAY SLICES");
+}
+
+static void md_drum_leds(void)
+{
+    uint32_t w;
+    int km = md_mute_kit();
+    for (w = 0; w < SMK_NPAD; w++) {
+        int k = w < 11 ? km : km ^ 1, v = k ? MD_ORD808[w < 11 ? w : w - 11] : MD_ORD909[w < 11 ? w : w - 11];
+        uint16_t c = PART_COL[k];
+        int sh = (md_drum_lit >> w) & 1u ? 0 : (k == ui.part && ui.sel[k] == v) ? 1 : w < 11 ? 3 : 4;
+        padled_set(w, (uint8_t)(((uint32_t)(c >> 11) * 255u / 31u) >> sh), (uint8_t)(((uint32_t)((c >> 5) & 63u) * 255u / 63u) >> sh),
+                   (uint8_t)(((uint32_t)(c & 31u) * 255u / 31u) >> sh));
+    }
+    padled_flush();
+}
+
+/* ------------------------------------------------------ performance keys --- */
+/* the 10 end keys the X0X has no use for: C3..E3 (keybed keys 0..4), G#5..C6 (32..36); held, they play */
+enum { PK_R2, PK_R4, PK_R8, PK_R16, PK_FILL, PK_ECHO, PK_KILL, PK_WASH, PK_RISE, PK_DROP, PK_N };
+static uint16_t md_pk;                                 /* held */
+static uint32_t md_pk_t0[PK_N];
+static uint16_t md_pk_bar0[PK_N];
+static uint8_t md_pk_all[PK_N];                        /* PATCH held when pressed: every part */
+static uint32_t md_kill_m, md_kill_v, md_drop_m;       /* the mute bits each one added */
+static int16_t md_save_mix[NPARTS][2];                 /* REV / DLY sends before a throw, a wash or a riser */
+static uint8_t md_send_hold[NPARTS][2];                /* who holds them: bit 0 throw/wash, bit 1 riser */
+static int16_t md_save_fx[4] = {-1, -1, -1, -1};       /* RV level, DL level, DL feedback, master FILTER */
+static uint32_t md_tail_t[2];                          /* a throw's / a wash's return: back at this time (0 = none) */
+static uint8_t md_rise_pend;                           /* the riser lets go at the next one */
+static uint16_t md_rise_bar;
+
+static uint32_t md_bar_ms(void)
+{
+    float b = seq_tempo(&seq);
+    return (uint32_t)(240000.0f / (b > 20.0f ? b : 120.0f));
+}
+static int md_sound(int t, int v, int i) { return proj.sound.v[t][v][i]; }
+
+static void md_send(int p, int which, int v, int who)  /* which 0 REV, 1 DLY */
+{
+    if (!md_send_hold[p][which])
+        md_save_mix[p][which] = (int16_t)md_sound(T_MIX, p, MX_REV + which);
+    md_send_hold[p][which] |= (uint8_t)who;
+    engine_set(T_MIX, p, MX_REV + which, v > md_save_mix[p][which] ? v : md_save_mix[p][which]);
+}
+static void md_send_let(int p, int which, int who)
+{
+    if (!(md_send_hold[p][which] & who))
+        return;
+    md_send_hold[p][which] &= (uint8_t)~who;
+    if (!md_send_hold[p][which])
+        engine_set(T_MIX, p, MX_REV + which, md_sound(T_MIX, p, MX_REV + which));
+}
+static void md_fx_up(int k, int t, int i, int v)       /* the returns: up, kept until md_fx_back */
+{
+    int base = md_sound(t, 0, i);
+    if (md_save_fx[k] < 0)
+        md_save_fx[k] = (int16_t)base;
+    engine_set(t, 0, i, v > base ? v : base);
+}
+static void md_fx_back(int k, int t, int i)
+{
+    if (md_save_fx[k] < 0)
+        return;
+    md_save_fx[k] = -1;
+    engine_set(t, 0, i, md_sound(t, 0, i));
+}
+
+static uint32_t md_all_mask(void)
+{
+    uint32_t all = 0;
+    int i;
+    for (i = 0; i < NPARTS; i++)
+        all |= MUTE_MASK[i];
+    return all;
+}
+
+/* mutes added now, taken off at the next one (now, when stopped) */
+static void md_mute_add(uint32_t m, uint32_t v, uint32_t *am, uint32_t *av)
+{
+    uint32_t l = fm1__lock();
+    uint32_t pm = seq.one_clr_m & m, pv = seq.one_clr_v & v;   /* still waiting for the one: keep them */
+    seq.one_clr_m &= ~m;
+    seq.one_clr_v &= ~v;
+    *am = (m & ~seq.mute) | pm;
+    if (av)
+        *av = (v & ~seq.vmute) | pv;
+    seq.mute |= m;
+    seq.vmute |= v;
+    fm1__unlock(l);
+}
+static void md_mute_back(uint32_t m, uint32_t v)
+{
+    uint32_t l = fm1__lock();
+    if (seq.playing) {
+        seq.one_clr_m |= m;
+        seq.one_clr_v |= v;
+    } else {
+        seq.mute &= ~m;
+        seq.vmute &= ~v;
+    }
+    fm1__unlock(l);
+}
+
+static void md_rate_say(void)
+{
+    static const char *const R[4] = {"REPEAT 1/2", "REPEAT 1/4", "REPEAT 1/8", "REPEAT 1/16"};
+    int k;
+    for (k = PK_R16; k >= PK_R2; k--)
+        if ((md_pk >> k) & 1u) {
+            seq.rpt = (uint8_t)(8 >> k);
+            say(R[k], 0);
+            return;
+        }
+    seq.rpt = 0;
+}
+
+static void md_fill_target(int *kit, int *v)
+{
+    if (ui.part <= PART_808) {
+        *kit = ui.part;
+        *v = ui.sel[ui.part];
+    } else {
+        *kit = 0;
+        *v = DR_SD;
+    }
+}
+
+static void md_perf_key(int k, int down)
+{
+    int p;
+    uint32_t bit = 1u << k;
+    ui.act_t = plat_ms();
+    if (down) {
+        md_pk |= (uint16_t)bit;
+        md_pk_t0[k] = plat_ms();
+        md_pk_bar0[k] = seq.bars_played;
+        md_pk_all[k] = (uint8_t)((plat_buttons() >> B_HOME) & 1u);
+        if (md_pk_all[k])
+            ui.btn_used |= 1u << B_HOME;
+    } else
+        md_pk &= (uint16_t)~bit;
+    switch (k) {
+    case PK_R2: case PK_R4: case PK_R8: case PK_R16:
+        md_rate_say();
+        if (!down && !seq.rpt)
+            say("REPEAT OFF", 0);
+        break;
+    case PK_FILL:
+        if (down) {
+            int kit, v;
+            char t[28];
+            md_fill_target(&kit, &v);
+            seq.roll_kit = (uint8_t)kit;
+            seq.roll_v = (uint8_t)v;
+            seq.roll_vel = 50;
+            seq.roll_div = 1;
+            put_s(put_s(t, "FILL "), engine_voice_name(kit ? T_808 : T_909, v));
+            say(t, 0);
+        } else
+            seq.roll_div = 0;
+        break;
+    case PK_ECHO: case PK_WASH: {
+        int which = k == PK_ECHO, tk = which;        /* tail 0: the wash's, 1: the throw's */
+        if (down) {
+            for (p = 0; p < NPARTS; p++)
+                if (md_pk_all[k] || p == ui.part)
+                    md_send(p, which, 112, 1);
+            if (which) {
+                md_fx_up(1, T_FX, FX_DL_LEVEL, 112);
+                md_fx_up(2, T_FX, FX_DL_FDBK, 100);
+            } else
+                md_fx_up(0, T_FX, FX_RV_LEVEL, 118);
+            md_tail_t[tk] = 0;
+            say(which ? (md_pk_all[k] ? "ECHO THROW: ALL" : "ECHO THROW") : (md_pk_all[k] ? "WASH: ALL" : "WASH"), 0);
+        } else {
+            for (p = 0; p < NPARTS; p++)
+                md_send_let(p, which, 1);
+            md_tail_t[tk] = plat_ms() + md_bar_ms();   /* the tail rings for a bar */
+            if (!md_tail_t[tk])
+                md_tail_t[tk] = 1;
+        }
+        break;
+    }
+    case PK_KILL:
+        if (down) {
+            md_mute_add(MUTE_MASK[PART_303A] | MUTE_MASK[PART_303B], 1u << DR_BD | 1u << (NDRUM + D8_BD), &md_kill_m, &md_kill_v);
+            say("KILL LOW: KICKS + BASS", 0);
+        } else {
+            md_mute_back(md_kill_m, md_kill_v);
+            md_kill_m = md_kill_v = 0;
+            say(seq.playing ? "LOW BACK ON THE ONE" : "LOW BACK", 0);
+        }
+        break;
+    case PK_DROP:
+        if (down) {
+            md_mute_add(md_all_mask(), 0, &md_drop_m, 0);
+            say("DROP", 0);
+        } else {
+            md_mute_back(md_drop_m, 0);
+            md_drop_m = 0;
+            say(seq.playing ? "BACK ON THE ONE" : "BACK", 0);
+        }
+        break;
+    case PK_RISE:
+        if (down) {
+            md_rise_pend = 0;
+            say("RISER", 0);
+        } else if (seq.playing) {
+            md_rise_pend = 1;
+            md_rise_bar = seq.bars_played;
+        } else
+            md_rise_pend = 2;
+        break;
+    }
+}
+
+static void md_riser_end(void)
+{
+    int p;
+    for (p = 0; p < NPARTS; p++)
+        md_send_let(p, 0, 2);
+    md_fx_back(3, T_MST, MST_DJF);
+    if (!((md_pk >> PK_WASH) & 1u) && !md_tail_t[0])
+        md_fx_back(0, T_FX, FX_RV_LEVEL);
+    md_rise_pend = 0;
+}
+
+static void md_perf_frame(void)                        /* what a held key does over time */
+{
+    uint32_t now = plat_ms();
+    if ((md_pk >> PK_FILL) & 1u) {                     /* FILL: faster at each bar line, louder as it goes */
+        uint32_t t = now - md_pk_t0[PK_FILL], b2 = 2u * md_bar_ms();
+        uint16_t bars = (uint16_t)(seq.bars_played - md_pk_bar0[PK_FILL]);
+        seq.roll_div = (uint8_t)(bars == 0 ? 1 : bars == 1 ? 2 : 4);
+        seq.roll_vel = (uint8_t)(50u + (t >= b2 ? 77u : 77u * t / b2));
+    }
+    if ((md_pk >> PK_RISE) & 1u) {                     /* RISER: the master high-pass and the reverb up over 4 bars */
+        uint32_t t = now - md_pk_t0[PK_RISE], b4 = 4u * md_bar_ms();
+        static int lastq = -1;
+        int q = (int)(t >= b4 ? 1000u : 1000u * t / b4), base = md_sound(T_MST, 0, MST_DJF), p;
+        int e = q * q / 1000;                          /* slow, then fast */
+        if (t < 40u)
+            lastq = -1;
+        if (q / 8 == lastq)                            /* (only when a value moves) */
+            goto risen;
+        lastq = q / 8;
+        if (base < 64)
+            base = 64;
+        if (md_save_fx[3] < 0)
+            md_save_fx[3] = (int16_t)md_sound(T_MST, 0, MST_DJF);
+        engine_set(T_MST, 0, MST_DJF, base + (124 - base) * e / 1000);
+        if (md_save_fx[0] < 0)
+            md_save_fx[0] = (int16_t)md_sound(T_FX, 0, FX_RV_LEVEL);
+        engine_set(T_FX, 0, FX_RV_LEVEL, md_save_fx[0] + (127 - md_save_fx[0]) * q / 1000);
+        for (p = 0; p < NPARTS; p++)
+            md_send(p, 0, md_sound(T_MIX, p, MX_REV) + 60 * q / 1000, 2);
+    }
+risen:
+    if (md_rise_pend == 2 || (md_rise_pend == 1 && (seq.bars_played != md_rise_bar || !seq.playing)))
+        md_riser_end();
+    if (md_tail_t[0] && (int32_t)(now - md_tail_t[0]) >= 0) {   /* a wash's return */
+        md_tail_t[0] = 0;
+        if (!((md_pk >> PK_RISE) & 1u) && !md_rise_pend)
+            md_fx_back(0, T_FX, FX_RV_LEVEL);
+    }
+    if (md_tail_t[1] && (int32_t)(now - md_tail_t[1]) >= 0) {   /* a throw's echoes */
+        md_tail_t[1] = 0;
+        md_fx_back(1, T_FX, FX_DL_LEVEL);
+        md_fx_back(2, T_FX, FX_DL_FDBK);
+    }
+}
+
+static void md_extkey(int32_t ev)                      /* keybed key << 8 | velocity (0: released) */
+{
+    int key = (int)(ev >> 8), k = key <= 4 ? key : key >= 32 ? key - 27 : -1;
+    int down = (ev & 0xFF) != 0;
+    if (k < 0 || k >= PK_N || (down && ui.overlay == O_ASK))   /* (a release always lets go) */
+        return;
+    if (down == (int)((md_pk >> k) & 1u))
+        return;
+    md_perf_key(k, down);
+}
+
+/* ----------------------------------------------------------- every frame --- */
+static uint32_t md_prev_raw;
+static uint32_t md_prev_pads;
+
+static void md_frame(void)
+{
+    uint32_t raw = fm1_in.buttons, pressed = raw & ~md_prev_raw, released = ~raw & md_prev_raw;
+    int home = (plat_buttons() >> B_HOME) & 1;
+    uint32_t r;
+    md_prev_raw = raw;
+    /* the knobs: X0X's own while a list, a question, GLO or PATCH wants them */
+    /* the knobs: X0X's own (stock), except while KNOB BANK is held: then K2..K4 are the instrument's */
+    md_nav = (uint8_t)(!((raw >> SMK_BTN_KNOB_BANK) & 1u) || ui.overlay != O_NONE || ui.view == V_GLO || ui.view == V_PERF || home);
+    if (!md_nav) {
+        int k;
+        for (k = 0; k < 3; k++) {
+            int32_t e = fm1_enc_take(panel.enc[EN_SELECT + k]) * panel.dir[EN_SELECT + k];
+            if (e) {
+                md_knob(k, (int)e);
+                md_mute_used = 1;                         /* a hold to shape the sound: no mute toggle */
+            }
+        }
+    }
+    /* KNOB BANK + OCTAVE- / +: the instrument before / after (alone they are X0X's OCT, as stock) */
+    for (r = FM1_BTN_OCT_DOWN; r <= FM1_BTN_OCT_UP; r++)
+        if ((pressed >> r) & 1u && (raw >> SMK_BTN_KNOB_BANK) & 1u) {
+            ui.act_t = plat_ms();
+            md_mute_used = 1;
+            md_select(md_inst() + (r == FM1_BTN_OCT_UP ? 1 : -1));
+        }
+    /* < / >: the instrument */
+    for (r = SMK_BTN_LEFT; r <= SMK_BTN_RIGHT; r++)
+        if ((pressed >> r) & 1u && !home && md_arrows_take()) {
+            ui.act_t = plat_ms();
+            md_part(ui.part + (r == SMK_BTN_RIGHT ? 1 : -1));
+        }
+    /* FX: the faders' switch. On (lit): REVERB, DELAY, DRIVE, FILTER, and the screen shows the effects;
+     * off: the parts' volumes, and the screen goes back to the instrument */
+    if ((pressed >> panel.btn[B_FX]) & 1u) {
+        md_fxf ^= 1u;
+        ui.act_t = plat_ms();
+        if (ui.overlay == O_NONE && ui.view != V_GLO)
+            set_view(md_fxf ? V_FX : V_PART);
+        say(md_fxf ? "FX ON: FADERS = EFFECTS" : "FX OFF: FADERS = VOLUMES", 0);
+    }
+    md_fx_lit = md_fxf;
+    md_piano();
+    /* PATCH + < / >: the pattern before / after (all parts, cued to the bar) */
+    for (r = SMK_BTN_LEFT; r <= SMK_BTN_RIGHT; r++) {
+        if ((pressed >> r) & 1u && home) {
+            int c = seq_cue_of(&seq, PART_909), p = (c >= 0 ? c : seq.ppat[PART_909]) + (r == SMK_BTN_RIGHT ? 1 : -1);
+            char t[16];
+            p = (p + NPAT) % NPAT;
+            ui.btn_used |= 1u << B_HOME;
+            seq_chain(&seq, 0, 0);
+            seq_cue(&seq, p);
+            ui.pbank = (uint8_t)(p / 16);
+            put_i(put_s(t, seq.playing ? "NEXT: P" : "PATTERN P"), p + 1);
+            say(t, 0);
+        }
+    }
+    /* KNOB BANK + FADER BANK: the pads play the kit (again: the steps) */
+    if ((pressed >> SMK_BTN_FADER_BANK) & 1u && (raw >> SMK_BTN_KNOB_BANK) & 1u) {
+        md_kb_held = 0;                                   /* (its release does nothing more) */
+        md_drums ^= 1u;
+        md_mute_on = 0;
+        md_drum_lit = 0;
+        say(md_drums ? "PADS PLAY THE KIT" : "PADS: STEPS", 0);
+    }
+    /* KNOB BANK: the mute pads (tap: on / off; hold: while held); PATCH + it: unmute all */
+    if ((pressed >> SMK_BTN_KNOB_BANK) & 1u) {
+        if (home) {
+            uint32_t l = fm1__lock();
+            ui.btn_used |= 1u << B_HOME;
+            seq.mute = 0;
+            seq.vmute = 0;
+            seq.one_clr_m = seq.one_clr_v = 0;
+            fm1__unlock(l);
+            md_solo = 0xFF;
+            say("ALL UNMUTED", 0);
+        } else {
+            md_kb_held = 1;
+            md_kb_t0 = plat_ms();
+            md_mute_used = 0;
+            if (!md_mute_on) {
+                md_mute_on = 2;                           /* 2: on since this press (a hold, or a tap that keeps it) */
+                say("MUTE PADS + FILTER KNOBS", 0);   /* (say: 27 chars) */
+            }
+        }
+    }
+    if ((released >> SMK_BTN_KNOB_BANK) & 1u && md_kb_held) {
+        int was = md_mute_on;
+        md_kb_held = 0;
+        if (md_mute_on == 2)                              /* just switched on: a tap keeps it, a played hold not */
+            md_mute_on = md_mute_used ? 0 : 1;
+        else if (!md_mute_used)
+            md_mute_on = 0;                               /* on before: a tap switches it off */
+        if (!md_mute_on && was == 1)
+            say("MUTE OFF", 0);
+    }
+    md_pads_muting = md_mute_on != 0 || md_drums;
+    md_mute_lit = md_mute_on != 0;
+    md_pads_home = md_drums && !md_mute_on;            /* drum pads: PATCH + a pad is still that pattern */
+    if (md_mute_on) {                                     /* mute pads; PATCH + a pad: solo */
+        uint32_t pads = fm1_in.pnotes, pp = pads & ~md_prev_pads, w;
+        for (w = 0; w < SMK_NPAD; w++)
+            if ((pp >> SMK_WHITE_NOTE[w]) & 1u) {
+                if (home) {
+                    ui.btn_used |= 1u << B_HOME;
+                    md_solo_pad((int)w);
+                } else {
+                    md_solo = 0xFF;                       /* a mute of its own: the solo is the new start */
+                    md_mute_pad((int)w);
+                }
+                md_mute_used = 1;
+            }
+        md_prev_pads = pads;
+    } else if (md_drums) {                                /* drum pads: hit, velocity, recorded with REC */
+        uint32_t pads = fm1_in.pnotes, pp = home ? 0 : pads & ~md_prev_pads, w;
+        md_drum_lit = 0;
+        for (w = 0; w < SMK_NPAD; w++) {
+            uint32_t n = SMK_WHITE_NOTE[w];
+            if ((pads >> n) & 1u)
+                md_drum_lit |= (uint16_t)(1u << w);
+            if ((pp >> n) & 1u)
+                md_drum_pad((int)w, fm1_in.key_vel[SMK_KEY_F3 + n]);
+        }
+        md_prev_pads = pads;
+    } else
+        md_prev_pads = fm1_in.pnotes;
+    md_perf_frame();
+    /* the mod wheel's riser follows the instrument on screen */
+    {
+        static int last_f = -1;
+        static uint8_t last_w;
+        int f = md_inst_flt(md_inst());
+        if (f != last_f && last_f >= 0 && last_w) {       /* another instrument: the last one as set */
+            uint8_t keep = md_wheel;
+            md_wheel = 0;
+            md_flt_apply(last_f);
+            md_wheel = keep;
+        }
+        if (f >= 0 && (md_wheel != last_w || f != last_f))
+            md_flt_apply(f);
+        last_f = f;
+        last_w = md_wheel;
+    }
+}
+
+static void md_wheel_set(int mw) { md_wheel = (uint8_t)mw; }
