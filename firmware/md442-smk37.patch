-    proj.set.bpm_x10 = 1250;
+    proj.set.bpm_x10 = 1420;            /* MD|442: Peak Warehouse */
     proj.set.accent_q7 = 88;
     proj.set.stereo = PROJ_STEREO;
     proj.set.snd_rev = PROJ_SND_REV;
@@ -52,6 +59,7 @@ void project_defaults(void)
