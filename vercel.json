{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/mathew-dj/",
      "permanent": false
    },
    {
      "source": "/md-442",
      "destination": "/md442/",
      "permanent": false
    },
    {
      "source": "/md-442/",
      "destination": "/md442/",
      "permanent": false
    },
    {
      "source": "/md-442/app",
      "destination": "/md442/app/",
      "permanent": false
    },
    {
      "source": "/md-442/app/",
      "destination": "/md442/app/",
      "permanent": false
    },
    {
      "source": "/md-911",
      "destination": "/md442/",
      "permanent": false
    },
    {
      "source": "/md-911/",
      "destination": "/md442/",
      "permanent": false
    },
    {
      "source": "/md-911/app",
      "destination": "/md442/app/",
      "permanent": false
    },
    {
      "source": "/md-911/app/",
      "destination": "/md442/app/",
      "permanent": false
    },
    {
      "source": "/md-187",
      "destination": "/md187/",
      "permanent": false
    },
    {
      "source": "/md-187/",
      "destination": "/md187/",
      "permanent": false
    },
    {
      "source": "/md-888",
      "destination": "/md888/",
      "permanent": false
    },
    {
      "source": "/md-888/",
      "destination": "/md888/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "midi=(self), camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/md(442|187|888)/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/md(442|187|888)/app/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/md(442|187|888)/app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/md(442|187|888)/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/md187/",
      "destination": "/md442/"
    },
    {
      "source": "/md187/:path*",
      "destination": "/md442/:path*"
    },
    {
      "source": "/md888/",
      "destination": "/md442/"
    },
    {
      "source": "/md888/:path*",
      "destination": "/md442/:path*"
    }
  ]
}
